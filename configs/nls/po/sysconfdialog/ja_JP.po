msgstr "アプリケーションを要求中"

#: userland/apps/sysconfdialog/main.c:107
msgid "Startup Application"
msgstr "自動起動アプリケーション"

#: userland/apps/sysconfdialog/main.c:75
msgid "Startup command"
msgstr "自動起動コマンド"

#: userland/apps/sysconfdialog/main.c:108
