msgid "Find a time zone"
msgstr "タイムゾーンを検索"

#: userland/apps/reliefsettings/window.cpp:660
msgid "Finish or cancel administrator authentication before closing."
msgstr "閉じる前に管理者認証を完了するか、キャンセルしてください。"

#: configs/nls/messages/reliefsettings.c:9
msgid "HOME must be an absolute path."
msgstr "HOME は絶対パスである必要があります。"

