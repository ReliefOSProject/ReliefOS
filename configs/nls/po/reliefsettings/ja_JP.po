#: userland/apps/fltk_support.h:48
msgid "Add to Favorites"
msgstr "お気に入りに追加"

#: userland/apps/reliefsettings/window.cpp:103
msgid "After applying, choose Keep within 15 seconds. The previous mode is restored automatically if you do not confirm."
msgstr "適用後、15 秒以内に「保持」を選択してください。確認しない場合は以前のモードに自動的に戻ります。"

#: userland/apps/fltk_support.h:49
msgid "All Files (*)"
msgstr "すべてのファイル (*)"

#: userland/apps/reliefsettings/window.cpp:269
msgid "All users"
msgstr "すべてのユーザー"

#: userland/apps/reliefsettings/window.cpp:70
msgid "Application language"
msgstr "アプリケーションの言語"

#: userland/apps/reliefsettings/window.cpp:656
msgid "Application started."
msgstr "アプリケーションを起動しました。"

#: userland/apps/reliefsettings/window.cpp:268
msgid "Apply"
msgstr "適用"

#: userland/apps/reliefsettings/window.cpp:116
msgid "Apply a layout, then type in the test field. Chinese text input is provided by your input method."
msgstr "レイアウトを適用してから、テスト欄に入力してください。中国語の入力は入力メソッドが提供します。"

#: userland/apps/reliefsettings/window.cpp:493
msgid "Applying…"
msgstr "適用中…"

#: userland/apps/reliefsettings/window.cpp:106
msgid "Available modes are reported by the X server and graphics driver. Confirmed settings are restored at your next sign-in."
msgstr "利用可能なモードは X サーバーとグラフィックスドライバーが提供します。確認済みの設定は次回のサインイン時に復元されます。"

#: userland/apps/fltk_support.h:44
msgid "Cancel"
msgstr "キャンセル"

#: configs/nls/messages/reliefsettings.c:4
msgid "Cannot create a temporary configuration file."
msgstr "一時設定ファイルを作成できません。"

#: configs/nls/messages/reliefsettings.c:5
msgid "Cannot read the current keyboard layout."
msgstr "現在のキーボードレイアウトを読み取れません。"

#: userland/apps/reliefsettings/window.cpp:656
msgid "Cannot start the application."
msgstr "アプリケーションを起動できません。"

#: userland/apps/reliefsettings/window.cpp:493
msgid "Cannot start the settings worker."
msgstr "設定用のワーカープロセスを起動できません。"

#: userland/apps/reliefsettings/window.cpp:370
msgid "Cannot start xrandr."
msgstr "xrandr を起動できません。"

#: userland/apps/reliefsettings/window.cpp:425
msgid "Choose a time zone."
msgstr "タイムゾーンを選択してください。"

#: userland/apps/fltk_support.h:45
msgid "Close"
msgstr "閉じる"

#: userland/apps/fltk_png_app.h:46
msgid "Could not decode image"
msgstr "画像をデコードできません"

#: userland/apps/fltk_support.h:57
msgid "Create a new directory"
msgstr "新しいフォルダーを作成"

