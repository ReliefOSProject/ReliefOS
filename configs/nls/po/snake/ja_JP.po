#: userland/apps/snake/main.c:337
msgid "Arrows/WASD move, P pause, Q quit"
msgstr "矢印/WASD: 移動、P: 一時停止、Q: 終了"

#: userland/apps/snake/main.c:335
msgid "GAME OVER - R restart, Q quit"
msgstr "ゲームオーバー - R: 再開、Q: 終了"

#: userland/apps/snake/main.c:336
msgid "PAUSED - P or Space to resume"
msgstr "一時停止中 - P または Space で再開"

#: userland/apps/snake/main.c:333
msgid "Snake  Score: %u  High score: %u  %s\n"
msgstr "スネーク  スコア: %u  最高: %u  %s\n"

#: userland/apps/snake/main.c:545
msgid "snake requires an interactive terminal"
msgstr "snake には対話型端末が必要です"
