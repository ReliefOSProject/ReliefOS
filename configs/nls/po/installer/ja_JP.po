msgid "Change partition type"
msgstr "パーティションの種類を変更"

#: userland/apps/installer/installer_tty.c:426
msgid "Changes remain pending until installation is confirmed."
msgstr "変更はインストールを確定するまで適用されません。"

#: userland/apps/installer/installer_tty.c:153
msgid "Changes remain pending until you confirm the installation. Going back keeps your choices."
msgstr "変更はインストールを確定するまで適用されません。前の手順に戻っても設定は保持されます。"

#: userland/apps/installer/main.cpp:229
msgid "Check Again"
msgstr "再確認"

#: userland/apps/installer/main.cpp:234
msgid "Check Update"
msgstr "更新を確認"

#: userland/apps/installer/installer_tty.c:363
msgid "Check system"
msgstr "システムを確認"

#: userland/apps/installer/main.cpp:1420
msgid "Check the target and planned changes. Use Back or the sidebar to change your choices."
msgstr "対象と変更内容を確認してください。「前へ」またはサイドバーから設定を変更できます。"

#: userland/apps/installer/installer_tty.c:493
msgid "Check username and matching passwords (1-32 characters, no spaces)."
msgstr "ユーザー名とパスワードの一致を確認してください (1～32 文字、スペース不可)。"

#: userland/apps/installer/installer_update_engine.c:611
msgid "Checking bootloader files on the installation media"
msgstr "インストールメディアのブートローダーファイルを確認しています"

#: userland/apps/installer/installer_update_engine.c:610
msgid "Checking installation media and free space"
msgstr "インストールメディアと空き容量を確認しています"

#: userland/apps/installer/installer_tui_job.c:215
msgid "Checking installed system"
msgstr "インストール済みシステムを確認中"

