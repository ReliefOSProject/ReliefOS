msgstr "wavplay: 再生に失敗しました"

#: userland/apps/wavplay/main.c:322
msgid "wavplay: playing 30-second 48000 Hz PCM tone (%u output channels)\n"
msgstr "wavplay: 30 秒の 48000 Hz PCM テスト音を再生中 (%u 出力チャンネル)\n"

#: userland/apps/wavplay/main.c:248
msgid "wavplay: supported files are PCM, stereo, 16-bit WAV"
msgstr "wavplay: 対応ファイルは PCM、ステレオ、16 ビット WAV です"

#: userland/apps/wavplay/main.c:274
msgid "wavplay: truncated WAV data"
msgstr "wavplay: WAV データが途中で切れています"

#: userland/apps/wavplay/main.c:68
msgid "wavplay: unsupported negotiated format=%d channels=%d rate=%d\n"
msgstr "wavplay: 対応していないネゴシエート後の形式 format=%d channels=%d rate=%d\n"

#: userland/apps/wavplay/main.c:53
msgid "wavplay: unsupported sample rate %u\n"
msgstr "wavplay: 対応していないサンプルレート %u\n"
