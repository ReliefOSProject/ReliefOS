#: userland/apps/wavplay/main.c:116
msgid "PCM write"
msgstr "PCM の書き込み"

#: userland/apps/wavplay/main.c:59
msgid "open /dev/dsp"
msgstr "/dev/dsp のオープン"

#: userland/apps/wavplay/main.c:136
msgid "stereo frame"
msgstr "ステレオフレーム"

#: userland/apps/wavplay/main.c:43
msgid "wavplay: %s failed (errno=%d)\n"
msgstr "wavplay: %s に失敗しました (errno=%d)\n"

#: userland/apps/wavplay/main.c:258
msgid "wavplay: %u Hz stereo PCM through /dev/dsp (%u output channels)\n"
msgstr "wavplay: %u Hz ステレオ PCM を /dev/dsp で再生 (%u 出力チャンネル)\n"

#: userland/apps/wavplay/main.c:329
msgid "wavplay: PCM tone complete"
msgstr "wavplay: PCM テスト音が完了しました"

#: userland/apps/wavplay/main.c:325
msgid "wavplay: PCM tone failed"
msgstr "wavplay: PCM テスト音の再生に失敗しました"

#: userland/apps/wavplay/main.c:254
msgid "wavplay: audio format rejected %d\n"
msgstr "wavplay: 音声形式が拒否されました %d\n"

#: userland/apps/wavplay/main.c:294
msgid "wavplay: complete"
msgstr "wavplay: 完了"

#: userland/apps/wavplay/main.c:244
msgid "wavplay: open failed %d\n"
msgstr "wavplay: オープンに失敗しました %d\n"

#: userland/apps/wavplay/main.c:262
msgid "wavplay: out of memory"
msgstr "wavplay: メモリ不足"

#: userland/apps/wavplay/main.c:284
