{
  "version": 1,
  "current_distributor": "reliefos-build",
  "apk_registration": "not-installed",
  "groups": {
    "reliefos-kernel": {
      "destination": "reliefos",
      "components": [],
      "paths": ["lib/modules", "usr/lib/reliefos/kernel"],
      "reason": "Matching versioned ReliefNT kernel, initramfs, modules and verified bundle metadata. Console/kernel products have no desktop icons."
    },
    "reliefos-grub": {
      "destination": "reliefos",
      "components": [],
      "paths": ["usr/sbin/grub-install", "usr/sbin/grub-bios-setup", "usr/sbin/grub-probe", "usr/bin/grub-mkimage", "usr/lib/grub", "usr/share/licenses/grub", "usr/sbin/reliefos-boot-install", "usr/libexec/reliefos/kernel-bundle", "lib/apk/commit_hooks.d/reliefos-kernel", "usr/sbin/leonos-grub-installer", "usr/sbin/reliefos-grub-installer"],
      "reason": "GNU GRUB 2.16 built from locked source for musl, its BIOS platform modules and GPL notices, and the shared ReliefOS boot installer CLI. Console tools have no desktop icons."
    },
    "reliefos-xdm-config": {
      "destination": "reliefos",
      "components": [],
      "paths": ["etc/X11/xdm/xdm-config", "etc/X11/xdm/Xservers", "etc/X11/xdm/Xresources", "usr/lib/X11/xdm/Xsession", "usr/lib/X11/xdm/Xsetup_0"],
      "reason": "Local XDM policy at the upstream default paths. The signed package depends on and replaces the overlapping configuration files of xdm, without modifying the upstream archive."
    },
    "reliefos-nls": {
      "destination": "reliefos",
      "components": [],
      "paths": ["usr/share/locale/zh_CN"],
      "reason": "Message catalogs from configs/nls/po, scoped per language to preserve upstream catalog ownership."
    },
    "reliefos-apps": {
      "destination": "reliefos",
      "components": ["installer", "login", "device-agent", "soundctl", "rcctl", "shell", "fileman", "taskmgr", "osver", "diskmgr", "driverinfo", "sudod", "reliefaskpass", "calc", "openrc-controller", "reliefapk", "reliefexcel", "reliefmail", "reliefword", "reliefppt", "paint", "minesweeper", "snake", "matrix", "memtest", "smptest", "abittest", "ipctest", "rprfetch", "imageview", "wavplay", "pleditor", "doomlauncher", "doom", "leonmmcoset", "xiaobai"],
      "paths": ["usr/lib/leonos", "usr/lib/reliefos", "usr/share/reliefos", "usr/share/fonts/reliefos", "etc/reliefos", "etc/icewm", "usr/sbin/leonos-rpr-apkcheck", "usr/sbin/leonos-rpr-ping", "usr/sbin/leonos-kernel-update", "usr/sbin/leonos-check-update", "usr/sbin/reliefos-rpr-apkcheck", "usr/sbin/reliefos-rpr-ping", "usr/sbin/reliefos-kernel-update", "usr/sbin/reliefos-check-update"],
      "reason": "Native desktop, service, graphics and application interfaces. Embedded dependencies remain part of their actual consumers."
    },
    "reliefos-reliefplayer": {
      "destination": "reliefos",
      "components": ["reliefplayer"],
      "paths": ["usr/bin/reliefplayer", "usr/share/applications/reliefos-reliefplayer.desktop"],
      "reason": "ReliefPlayer audio executable, launcher, desktop entry and component artwork are installed and removed together. minimp3 remains embedded in its consumers."
    },
    "reliefos-network-controller": {
      "destination": "reliefos",
      "components": ["network-controller"],
      "paths": ["usr/bin/network-controller", "usr/share/applications/reliefos-network-controller.desktop"],
      "reason": "Network Controller GUI, restricted worker, launcher, desktop entry and artwork are installed and removed together. Shared network boot and resolver tools remain independent of the optional GUI."
    },
    "reliefos-reliefcapture": {
      "destination": "reliefos",
      "components": ["reliefcapture"],
      "paths": ["usr/bin/reliefcapture", "usr/share/applications/reliefos-reliefcapture.desktop"],
      "reason": "ReliefCapture screenshot and annotation executable, launcher, desktop entry and component artwork are installed and removed together."
    },
    "reliefos-reliefdiagram": {
      "destination": "reliefos",
      "components": ["reliefdiagram"],
      "paths": ["usr/bin/reliefdiagram", "usr/share/applications/reliefos-reliefdiagram.desktop", "usr/share/mime/packages/reliefdiagram.xml"],
      "reason": "ReliefDiagram editor, desktop entry, MIME declaration and component artwork are installed and removed together."
    },
    "reliefos-reliefmathpp": {
      "destination": "reliefos",
      "components": ["reliefmathpp"],
      "paths": ["usr/bin/reliefmathpp", "usr/share/applications/reliefos-reliefmathpp.desktop", "usr/share/mime/packages/reliefmathpp.xml"],
      "reason": "ReliefMath++ geometry application, desktop entry, MIME declaration and component artwork are installed and removed together."
    },
    "reliefos-relieftodo": {
      "destination": "reliefos",
      "components": ["relieftodo"],
      "paths": ["usr/bin/relieftodo", "usr/share/applications/reliefos-relieftodo.desktop", "usr/share/mime/packages/relieftodo.xml"],
      "reason": "ReliefTodo task manager, desktop launcher, MIME declaration and component artwork are installed and removed together."
    },
    "reliefos-reliefmath": {
      "destination": "reliefos",
      "components": ["reliefmath"],
      "paths": ["usr/bin/reliefmath", "usr/share/applications/reliefos-reliefmath.desktop", "usr/share/mime/packages/reliefmath.xml", "usr/share/reliefmath", "usr/share/licenses/reliefmath"],
      "reason": "ReliefMath GUI and isolated worker, their private math font and license texts, desktop launcher, MIME declaration and component icon are installed and removed together."
    },
    "reliefos-fastfetch": {
      "destination": "reliefos",
      "components": ["fastfetch"],
      "future_apk_conflicts": ["fastfetch"],
      "reason": "Retain the verified ReliefOS release with the legacy LeonOS Logo alias. The future real local APK must depend on !fastfetch. This manifest does not enforce that conflict."
    },
    "musl": {
      "destination": "alpine-after-validation",
      "components": [],
      "paths": ["lib/ld-musl-x86_64.so.1", "lib/libc.so", "etc/ld-musl-x86_64.path"],
      "alpine_candidates": ["musl"],
      "reason": "Password-file locking patch and loader ABI require validation before replacing the running system libc. No fabricated musl provides."
    },
    "reliefos-mimalloc": {
      "destination": "reliefos",
      "components": [],
      "paths": ["lib/libmimalloc.so.3"],
      "reason": "ReliefOS runtime allocator contract; statically linked copies belong to their consumers."
    },
    "reliefos-musl-dev": {
      "destination": "reliefos",
      "components": [],
      "paths": ["usr/share/licenses/leonos-musl-dev", "usr/share/licenses/reliefos-musl-dev"],
      "reason": "Default-installed headers, startup objects and static libraries generated from the exact runtime musl sysroot. The APK builder assigns their exact file paths when packaging and repackaging roots."
    },
    "busybox": {
      "destination": "alpine-after-validation",
      "components": ["busybox"],
      "alpine_candidates": ["busybox"],
      "reason": "Transfer /bin/sh and applet symlinks together after shell, init and installer regressions. Separately installed utilities retain their own paths."
    },
    "findutils": {
      "destination": "alpine-after-validation",
      "components": [],
      "paths": ["usr/bin/find", "usr/bin/xargs"],
      "alpine_candidates": ["findutils"],
      "reason": "Use the official Alpine findutils implementation for find and xargs; do not duplicate these commands in BusyBox."
    },
    "coreutils": {
      "destination": "alpine-after-validation",
      "components": [],
      "paths": [
        "usr/bin/[", "usr/bin/arch", "usr/bin/b2sum", "usr/bin/base32",
        "usr/bin/base64", "usr/bin/basename", "usr/bin/basenc", "usr/bin/cat",
        "usr/bin/chcon", "usr/bin/chgrp", "usr/bin/chmod", "usr/bin/chown",
        "usr/bin/chroot", "usr/bin/cksum", "usr/bin/comm", "usr/bin/coreutils",
        "usr/bin/cp", "usr/bin/csplit", "usr/bin/cut", "usr/bin/date",
        "usr/bin/dd", "usr/bin/df", "usr/bin/dir", "usr/bin/dircolors",
        "usr/bin/dirname", "usr/bin/du", "usr/bin/echo", "usr/bin/env",
        "usr/bin/expand", "usr/bin/expr", "usr/bin/factor", "usr/bin/false",
        "usr/bin/fmt", "usr/bin/fold", "usr/bin/groups", "usr/bin/head",
        "usr/bin/hostid", "usr/bin/hostname", "usr/bin/id", "usr/bin/install",
        "usr/bin/join", "usr/bin/kill", "usr/bin/link", "usr/bin/ln",
        "usr/bin/logname", "usr/bin/ls", "usr/bin/md5sum", "usr/bin/mkdir",
        "usr/bin/mkfifo", "usr/bin/mknod", "usr/bin/mktemp", "usr/bin/mv",
        "usr/bin/nice", "usr/bin/nl", "usr/bin/nohup", "usr/bin/nproc",
        "usr/bin/numfmt", "usr/bin/od", "usr/bin/paste", "usr/bin/pathchk",
        "usr/bin/pinky", "usr/bin/pr", "usr/bin/printenv", "usr/bin/printf",
        "usr/bin/ptx", "usr/bin/pwd", "usr/bin/readlink", "usr/bin/realpath",
        "usr/bin/rm", "usr/bin/rmdir", "usr/bin/runcon", "usr/bin/seq",
        "usr/bin/sha1sum", "usr/bin/sha224sum", "usr/bin/sha256sum", "usr/bin/sha384sum",
        "usr/bin/sha512sum", "usr/bin/shred", "usr/bin/shuf", "usr/bin/sleep",
        "usr/bin/sort", "usr/bin/split", "usr/bin/stat", "usr/bin/stdbuf",
        "usr/bin/stty", "usr/bin/sum", "usr/bin/sync", "usr/bin/tac",
        "usr/bin/tail", "usr/bin/tee", "usr/bin/test", "usr/bin/timeout",
        "usr/bin/touch", "usr/bin/tr", "usr/bin/true", "usr/bin/truncate",
        "usr/bin/tsort", "usr/bin/tty", "usr/bin/uname", "usr/bin/unexpand",
        "usr/bin/uniq", "usr/bin/unlink", "usr/bin/uptime", "usr/bin/users",
        "usr/bin/vdir", "usr/bin/wc", "usr/bin/who", "usr/bin/whoami",
        "usr/bin/yes", "usr/libexec/coreutils", "usr/share/licenses/coreutils", "usr/share/doc/coreutils",
        "usr/share/info/coreutils.info", "usr/share/info/coreutils.info-1", "usr/share/info/coreutils.info-2", "usr/share/info/coreutils.info-3",
        "usr/share/info/coreutils.info-4", "usr/share/info/coreutils.info-5", "usr/share/info/coreutils.info-6", "usr/share/man/man1/arch.1",
        "usr/share/man/man1/b2sum.1", "usr/share/man/man1/base32.1", "usr/share/man/man1/base64.1", "usr/share/man/man1/basename.1",
        "usr/share/man/man1/basenc.1", "usr/share/man/man1/cat.1", "usr/share/man/man1/chcon.1", "usr/share/man/man1/chgrp.1",
        "usr/share/man/man1/chmod.1", "usr/share/man/man1/chown.1", "usr/share/man/man1/chroot.1", "usr/share/man/man1/cksum.1",
        "usr/share/man/man1/comm.1", "usr/share/man/man1/coreutils.1", "usr/share/man/man1/cp.1", "usr/share/man/man1/csplit.1",
        "usr/share/man/man1/cut.1", "usr/share/man/man1/date.1", "usr/share/man/man1/dd.1", "usr/share/man/man1/df.1",
        "usr/share/man/man1/dir.1", "usr/share/man/man1/dircolors.1", "usr/share/man/man1/dirname.1", "usr/share/man/man1/du.1",
        "usr/share/man/man1/echo.1", "usr/share/man/man1/env.1", "usr/share/man/man1/expand.1", "usr/share/man/man1/expr.1",
        "usr/share/man/man1/factor.1", "usr/share/man/man1/false.1", "usr/share/man/man1/fmt.1", "usr/share/man/man1/fold.1",
        "usr/share/man/man1/groups.1", "usr/share/man/man1/head.1", "usr/share/man/man1/hostid.1", "usr/share/man/man1/hostname.1",
        "usr/share/man/man1/id.1", "usr/share/man/man1/install.1", "usr/share/man/man1/join.1", "usr/share/man/man1/kill.1",
        "usr/share/man/man1/link.1", "usr/share/man/man1/ln.1", "usr/share/man/man1/logname.1", "usr/share/man/man1/ls.1",
        "usr/share/man/man1/md5sum.1", "usr/share/man/man1/mkdir.1", "usr/share/man/man1/mkfifo.1", "usr/share/man/man1/mknod.1",
        "usr/share/man/man1/mktemp.1", "usr/share/man/man1/mv.1", "usr/share/man/man1/nice.1", "usr/share/man/man1/nl.1",
        "usr/share/man/man1/nohup.1", "usr/share/man/man1/nproc.1", "usr/share/man/man1/numfmt.1", "usr/share/man/man1/od.1",
        "usr/share/man/man1/paste.1", "usr/share/man/man1/pathchk.1", "usr/share/man/man1/pinky.1", "usr/share/man/man1/pr.1",
        "usr/share/man/man1/printenv.1", "usr/share/man/man1/printf.1", "usr/share/man/man1/ptx.1", "usr/share/man/man1/pwd.1",
        "usr/share/man/man1/readlink.1", "usr/share/man/man1/realpath.1", "usr/share/man/man1/rm.1", "usr/share/man/man1/rmdir.1",
        "usr/share/man/man1/runcon.1", "usr/share/man/man1/seq.1", "usr/share/man/man1/sha1sum.1", "usr/share/man/man1/sha224sum.1",
        "usr/share/man/man1/sha256sum.1", "usr/share/man/man1/sha384sum.1", "usr/share/man/man1/sha512sum.1", "usr/share/man/man1/shred.1",
        "usr/share/man/man1/shuf.1", "usr/share/man/man1/sleep.1", "usr/share/man/man1/sort.1", "usr/share/man/man1/split.1",
        "usr/share/man/man1/stat.1", "usr/share/man/man1/stdbuf.1", "usr/share/man/man1/stty.1", "usr/share/man/man1/sum.1",
        "usr/share/man/man1/sync.1", "usr/share/man/man1/tac.1", "usr/share/man/man1/tail.1", "usr/share/man/man1/tee.1",
        "usr/share/man/man1/test.1", "usr/share/man/man1/timeout.1", "usr/share/man/man1/touch.1", "usr/share/man/man1/tr.1",
        "usr/share/man/man1/true.1", "usr/share/man/man1/truncate.1", "usr/share/man/man1/tsort.1", "usr/share/man/man1/tty.1",
        "usr/share/man/man1/uname.1", "usr/share/man/man1/unexpand.1", "usr/share/man/man1/uniq.1", "usr/share/man/man1/unlink.1",
        "usr/share/man/man1/uptime.1", "usr/share/man/man1/users.1", "usr/share/man/man1/vdir.1", "usr/share/man/man1/wc.1",
        "usr/share/man/man1/who.1", "usr/share/man/man1/whoami.1", "usr/share/man/man1/yes.1"
      ],
      "alpine_candidates": ["coreutils"],
      "reason": "The complete locked GNU coreutils suite, its multi-call command links, historical executable-path aliases, stdbuf preload library, manuals and licenses are one signed package. BusyBox supplies no same-name PATH links; explicit BusyBox applet calls remain available for bootstrap and update helpers."
    },
    "authentication": {
      "destination": "alpine-after-validation",
      "components": ["sudo", "su"],
      "library_stems": ["lib/libpam", "lib/libpam_misc", "lib/libpamc", "lib/libcrypt", "usr/lib/libsubid"],
      "paths": ["bin/su", "usr/bin/sudo", "usr/bin/sudoedit", "usr/bin/passwd", "sbin/unix_chkpwd", "lib/security", "usr/lib/security", "usr/lib/sudo", "etc/pam.d", "etc/security", "etc/sudoers", "etc/sudoers.d", "etc/sudo.conf", "lib/libpam.so.0", "lib/libpam_misc.so.0", "lib/libpamc.so.0", "lib/libcrypt.so.2"],
      "alpine_candidates": ["linux-pam", "shadow", "sudo", "libxcrypt"],
      "reason": "PAM patches and pam_leonos_password need real local packaging; preserve policy, setuid modes and login semantics before any upstream replacement."
    },
    "auth-support-libraries": {
      "destination": "alpine-after-validation",
      "components": [],
      "library_stems": ["lib/libbsd", "lib/libmd"],
      "paths": ["usr/include/bsd", "usr/share/licenses/libbsd", "usr/share/licenses/libmd"],
      "alpine_candidates": ["libbsd", "libmd"],
      "reason": "Upstream dependencies of shadow; transfer headers, libraries and metadata with authentication consumers."
    },
    "storage-util-linux": {
      "destination": "alpine-after-validation",
      "components": [],
      "library_stems": ["usr/lib/libfdisk", "usr/lib/libsmartcols", "usr/lib/libuuid", "usr/lib/libblkid", "usr/lib/libmount"],
      "alpine_candidates": ["util-linux"],
      "reason": "Includes split libraries and command packages; resolve actual repository file ownership before choosing subpackages. Installer relies on these tools."
    },
    "storage-filesystems": {
      "destination": "alpine-after-validation",
      "components": [],
      "library_stems": ["usr/lib/libcom_err", "usr/lib/libe2p", "usr/lib/libext2fs", "usr/lib/libss"],
      "paths": ["usr/include/ext2fs", "usr/include/ss", "usr/include/e2p", "usr/include/et", "usr/include/com_err.h", "usr/share/et", "usr/share/ss"],
      "alpine_candidates": ["e2fsprogs", "dosfstools", "exfatprogs"],
      "reason": "Transfer formatter/checker aliases with commands; preserve ext2 installer behavior."
    },
    "ncurses": {
      "destination": "alpine-after-validation",
      "components": ["ncurses"],
      "alpine_candidates": ["ncurses", "ncurses-terminfo"],
      "reason": "Resolve terminal data/tools split and libraries from repository metadata; preserve leonos TERM support."
    },
    "ca-certificates-bundle": {
      "destination": "alpine-after-validation",
      "components": [],
      "paths": ["etc/ssl/certs/ca-certificates.crt"],
      "alpine_candidates": ["ca-certificates-bundle"],
      "reason": "The actual CA bundle is packaged separately so curl dependencies and authenticated upstream updates can own it."
    },
    "sqlite": {
      "destination": "alpine-after-validation",
      "components": ["sqlite"],
      "paths": ["usr/lib/sqlite.so.3"],
      "alpine_candidates": ["sqlite", "sqlite-libs"],
      "reason": "Current custom SONAME and native consumers need migration before upstream library replacement."
    },
    "sl": {
      "destination": "alpine-after-validation",
      "components": ["sl"],
      "alpine_candidates": ["sl"],
      "reason": "Generic optional terminal application."
    },
    "trust": {
      "destination": "alpine-after-validation",
      "components": [],
      "paths": ["etc/ssl/certs", "etc/ssl/cert.pem", "etc/apk/keys", "etc/apk/ca.pem", "etc/apk/protected_paths.d/reliefos-ca-bundle.list", "usr/share/reliefos/certs", "usr/share/licenses/alpine-keys"],
      "alpine_candidates": ["ca-certificates", "alpine-keys"],
      "reason": "Transfer trust data via authenticated packages; validate certificate update triggers on ReliefOS."
    },
    "reliefos-apk-tools": {
      "destination": "reliefos",
      "components": [],
      "paths": ["sbin/apk", "usr/lib/leonos/leonos-apk-update", "usr/lib/reliefos/leonos-apk-update", "usr/lib/reliefos/reliefos-apk-update", "usr/share/licenses/apk-tools"],
      "reason": "Upstream apk transaction tools plus the local signed repository updater and legacy command paths."
    },
    "reliefos-base": {
      "destination": "reliefos",
      "components": [],
      "reason": "Fallback distribution inventory, not proof of an individual package producer. Includes kernel, boot, identity and layout; review every fallback before generating APKs."
    }
  },
  "apk_only_future_packages": ["python3", "gcc", "g++", "binutils", "musl-dev", "tcc"],
  "forbidden_shortcuts": ["fake-installed-database", "fake-provides", "force-overwrite", "disable-signature-verification", "disable-tls-verification"]
}
