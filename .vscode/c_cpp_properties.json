{
    "version": 4,
    "enableConfigurationSquiggles": true,
    "configurations": [
        {
            "name": "ReliefOS Kernel (WSL)",
            "compilerPath": "/usr/bin/clang",
            "intelliSenseMode": "linux-clang-x64",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "compileCommands": "${workspaceFolder}/out/vscode/compile_commands.json",
            "browse": {
                "path": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}/userland",
                    "${workspaceFolder}/kernel/reliefnt"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "ReliefOS Runtime (WSL)",
            "compilerPath": "/usr/bin/clang",
            "intelliSenseMode": "linux-clang-x64",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "compileCommands": "${workspaceFolder}/out/vscode/compile_commands.json",
            "browse": {
                "path": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}/userland",
                    "${workspaceFolder}/kernel/reliefnt"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "ReliefOS Userland (WSL)",
            "compilerPath": "/usr/bin/clang",
            "intelliSenseMode": "linux-clang-x64",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "compileCommands": "${workspaceFolder}/out/vscode/compile_commands.json",
            "browse": {
                "path": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}/userland",
                    "${workspaceFolder}/kernel/reliefnt"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
