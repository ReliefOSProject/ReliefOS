            "command": "wsl.exe",
            "args": ["--cd", "${config:leonos.wslProjectRoot}", "--", "bash", "-lc", "python3 tools/vscode/run_clang_tidy.py --region libc"],
            "dependsOn": "ReliefOS: Generate compile database (libc)",
            "problemMatcher": [],
