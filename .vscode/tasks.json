            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${config:leonos.wslProjectRoot}", "--", "bash", "-lc", "python3 tools/vscode/generate_compile_commands.py --region kernel"],
            "problemMatcher": [],
