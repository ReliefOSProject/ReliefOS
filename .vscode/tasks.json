        },
        {
            "label": "ReliefOS: clang-tidy userland",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${config:leonos.wslProjectRoot}", "--", "bash", "-lc", "python3 tools/vscode/run_clang_tidy.py --region userland"],
            "dependsOn": "ReliefOS: Generate compile database (userland)",
            "problemMatcher": [],
            "presentation": {"reveal": "always", "panel": "shared", "clear": false}
        },
        {
            "label": "ReliefOS: clang-tidy devtools SDK",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${config:leonos.wslProjectRoot}", "--", "bash", "-lc", "python3 tools/vscode/run_clang_tidy.py --region devtools"],
            "dependsOn": "ReliefOS: Generate compile database (devtools SDK)",
            "problemMatcher": [],
