{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ReliefOS: Build image (VMDK)",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "--cd",
                "${config:leonos.wslProjectRoot}",
                "--",
                "bash",
                "-lc",
                "make image-vmdk"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            }
        },
        {
            "label": "ReliefOS: Build all",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "--cd",
                "${config:leonos.wslProjectRoot}",
                "--",
                "bash",
                "-lc",
                "make all"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            }
        },
        {
            "label": "ReliefOS: Build kernel",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "--cd",
                "${config:leonos.wslProjectRoot}",
                "--",
                "bash",
                "-lc",
                "make kernel"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            }
        },
        {
            "label": "ReliefOS: Build installer",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "--cd",
                "${config:leonos.wslProjectRoot}",
                "--",
                "bash",
                "-lc",
                "make installer"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            }
        },
        {
            "label": "ReliefOS: Run QEMU",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "--cd",
                "${config:leonos.wslProjectRoot}",
                "--",
                "bash",
                "-lc",
                "make run"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "ReliefOS: Start QEMU for GDB",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "--cd",
                "${config:leonos.wslProjectRoot}",
                "--",
                "bash",
                "-lc",
                "ovmf='${config:leonos.wslOvmfPath}'; test -r \"$ovmf\" || { echo \"OVMF not found: $ovmf\"; exit 1; }; rm -f build/qemu-vscode.pid build/qemu-vscode-serial.log; echo 'ReliefOS QEMU GDB starting'; qemu-system-x86_64 -cpu max -machine q35 -m 512M -bios \"$ovmf\" -serial file:build/qemu-vscode-serial.log -device VGA,xres=1920,yres=1080 -netdev user,id=net0 -device e1000,netdev=net0 -audiodev driver=none,id=snd0 -device AC97,audiodev=snd0 -gdb tcp::1234 -S -no-reboot -no-shutdown -pidfile build/qemu-vscode.pid -drive file=out/x86_64/release/images/reliefos.vmdk,if=none,id=sata0 -device ich9-ahci,id=ahci -device ide-hd,drive=sata0,bus=ahci.0; code=$?; rm -f build/qemu-vscode.pid; exit $code"
            ],
            "dependsOn": "ReliefOS: Build image (VMDK)",
            "dependsOrder": "sequence",
            "isBackground": true,
            "problemMatcher": {
                "owner": "reliefos-qemu",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^ReliefOS QEMU GDB starting$",
                    "endsPattern": "^ReliefOS QEMU GDB starting$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "ReliefOS: Stop QEMU for GDB",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "--cd",
                "${config:leonos.wslProjectRoot}",
                "--",
                "bash",
                "-lc",
                "if test -s build/qemu-vscode.pid; then pid=$(cat build/qemu-vscode.pid); kill -TERM \"$pid\" 2>/dev/null || true; fi; rm -f build/qemu-vscode.pid"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "panel": "dedicated",
                "showReuseMessage": false
            }
        },
        {
            "label": "ReliefOS: Test terminal (QMP)",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "--cd",
                "${config:leonos.wslProjectRoot}",
                "--",
                "bash",
                "-lc",
                "python3 build.py test qmp-terminal"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            }
        },
        {
            "label": "ReliefOS: Generate compile database (all regions)",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "--cd",
                "${config:leonos.wslProjectRoot}",
                "--",
                "bash",
                "-lc",
                "python3 tools/vscode/generate_compile_commands.py --region all"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {"reveal": "always", "panel": "shared", "clear": false}
        },
        {
