# Public tool names; native hostprogs are declared in tools/host/Kbuild.
RELIEFOS_HOST_BIN := $(O_HOST)/bin
RELIEFOS_EMIT ?= $(if $(strip $(LEONOS_EMIT)),$(LEONOS_EMIT),$(RELIEFOS_HOST_BIN)/reliefos-emit)
RELIEFOS_VERSION_TOOL ?= $(if $(strip $(LEONOS_VERSION_TOOL)),$(LEONOS_VERSION_TOOL),$(RELIEFOS_HOST_BIN)/reliefos-version)
RELIEFOS_DEPS_TOOL ?= $(if $(strip $(LEONOS_DEPS_TOOL)),$(LEONOS_DEPS_TOOL),$(RELIEFOS_HOST_BIN)/reliefos-deps)
RELIEFOS_GBK_TOOL ?= $(if $(strip $(LEONOS_GBK_TOOL)),$(LEONOS_GBK_TOOL),$(RELIEFOS_HOST_BIN)/reliefos-gbk)
RELIEFOS_SDK_DRIVER ?= $(if $(strip $(LEONOS_SDK_DRIVER)),$(LEONOS_SDK_DRIVER),$(RELIEFOS_HOST_BIN)/reliefos-musl-cc)
RELIEFOS_APK_OWN ?= $(if $(strip $(LEONOS_APK_OWN)),$(LEONOS_APK_OWN),$(RELIEFOS_HOST_BIN)/reliefos-apk-own)
RELIEFOS_NLS_EXTRACT ?= $(if $(strip $(LEONOS_NLS_EXTRACT)),$(LEONOS_NLS_EXTRACT),$(RELIEFOS_HOST_BIN)/reliefos-nls-extract)
RELIEFOS_HOST_COMMON_OBJS := ./tools/host/common/buffer.o ./tools/host/common/io.o ./tools/host/common/process.o
RELIEFOS_JSON_OBJ := ./tools/host/manifest/json.o
RELIEFOS_KERNEL_TOOLS := $(RELIEFOS_HOST_BIN)/reliefos-kernel-tools
RELIEFOS_HOST_TOOLS := $(RELIEFOS_HOST_BIN)/reliefos-emit $(RELIEFOS_HOST_BIN)/reliefos-version $(RELIEFOS_HOST_BIN)/reliefos-deps $(RELIEFOS_HOST_BIN)/reliefos-gbk $(RELIEFOS_HOST_BIN)/reliefos-musl-cc $(RELIEFOS_HOST_BIN)/reliefos-apk-own $(RELIEFOS_HOST_BIN)/reliefos-nls-extract $(RELIEFOS_HOST_BIN)/reliefos-components $(RELIEFOS_HOST_BIN)/reliefos-grub-font $(RELIEFOS_HOST_BIN)/reliefos-ext2-time $(RELIEFOS_HOST_BIN)/reliefos-dedup $(RELIEFOS_HOST_BIN)/reliefos-stage $(RELIEFOS_HOST_BIN)/reliefos-layout $(RELIEFOS_HOST_BIN)/reliefos-oschinpt-index
RELIEFOS_HOST_TOOLS += $(RELIEFOS_KERNEL_TOOLS)
