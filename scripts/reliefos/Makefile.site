# GitHub Pages assembly target.
#
# The Pages tree is assembled from build artifacts that already exist by this
# point: the RPR tree from $(RPR_PAGES) (tools/build/rpr-pages.sh) and the
# installer ISO from $(INSTALLER_ISO) (scripts/reliefos/Makefile.images). Nothing here rebuilds a
# kernel or APK repository; it only arranges finished outputs into one atomic,
# deployable site and adds the human-readable pages (plan §19, §29, §31).
#
#   make pages      assemble out/<arch>/<profile>/pages/ (home + download + rpr + docs)
#
# `site` and `download-page` are provided as the plan's named entry points and
# are wired to the same atomic assembly: the download page cannot be published
# without the shared stylesheet at the site root, so a partial tree would ship
# broken links. Keeping one output is what makes the release atomic (plan §45).
# `rpr-pages` generates only the local package/kernel subtree; site navigation
# and documentation links require this complete Pages assembly.
SITE_CSS     := $(RELIEFOS_SRC)/resources/pages/css/reliefos.css
SITE_SCRIPTS := $(RELIEFOS_SRC)/tools/build/site.sh \
                $(RELIEFOS_SRC)/tools/build/download-page.sh \
                $(RELIEFOS_SRC)/tools/build/home-page.sh \
                $(RELIEFOS_SRC)/tools/build/docs-page.sh \
                $(RELIEFOS_SRC)/scripts/build-docs.sh \
                $(RELIEFOS_SRC)/tools/build/site-common.sh
# Each repository owns its Documentation/ tree. Directory prerequisites also
# track removed pages, so deleted source cannot linger in a published manual.
SITE_DOCS    := $(shell find $(RELIEFOS_SRC)/Documentation $(RELIEFNT_DIR)/Documentation \( -type f -o -type d \) | LC_ALL=C sort) \
                $(RELIEFOS_SRC)/configs/build-version $(RELIEFNT_DIR)/configs/build-version
PAGES        := $(O)/pages

$(PAGES)/.site-complete $(PAGES)/index.html &: \
        $(RPR_PAGES)/.complete $(RPR_PAGES)/manifest.json \
        $(INSTALLER_ISO) $(BUILD_INFO_HEADER) $(SITE_CSS) $(SITE_SCRIPTS) $(SITE_DOCS)
	$(Q)sh $(RELIEFOS_SRC)/tools/build/site.sh \
		$(RPR_PAGES) $(INSTALLER_ISO) $(BUILD_INFO_HEADER) $(SITE_CSS) $(PAGES) $(RELIEFNT_DIR)/Documentation

.PHONY: pages site download-page docs-page
pages: $(PAGES)/.site-complete
site: pages
download-page: pages
docs-page: pages
