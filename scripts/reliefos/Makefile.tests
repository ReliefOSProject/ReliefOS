# Test targets.
#
# The core harness is POSIX shell and C: the acceptance rule for this migration
# may not depend on the interpreter it is auditing (plan section 2).

export RELIEFOS_TEST_DEP_ROOT := $(abspath $(HOST_RUNTIME_DEVELOPMENT_ROOT))
export RELIEFOS_TEST_BUILD_ROOT := $(abspath $(O))
RELIEFOS_TEST_PYTHON ?= python3

RELIEFOS_TEST_TMP := $(if $(TMPDIR),$(TMPDIR),/tmp)/reliefos-tests-$(shell id -u)

# C unit tests for the shared host primitives and the JSON reader.
RELIEFOS_HOST_TEST_BINS := $(O_HOST)/tests/test_common $(O_HOST)/tests/test_json
RELIEFOS_HOST_TEST_SANITISED := $(O_HOST)/tests-sanitised/test_common \
	$(O_HOST)/tests-sanitised/test_json
RELIEFOS_HOST_TEST_BINS += $(O_HOST)/tests/test_locale_conf
RELIEFOS_HOST_TEST_SANITISED += $(O_HOST)/tests-sanitised/test_locale_conf

# Shell contract tests. test-bootstrap.sh is the public entry-point surface.
# test-brand-identity.sh is the ReliefOS/ReliefNT rename gate (plan task 1) and
# is picked up by this wildcard on purpose: every test-build run audits names.
RELIEFOS_BUILD_TESTS := $(sort $(wildcard $(RELIEFOS_SRC)/tests/build/test-*.sh))
# Local `make test` keeps the complete inventory. CI runs its core in the image
# build and the explicit heavy groups in independent runner/source checkouts.
# The selector validates all shards before filtering, so a renamed/missing
# offloaded suite fails before a partial test run can be reported as complete.
RELIEFOS_CI_TEST_GROUP ?= all
ifneq ($(words $(RELIEFOS_CI_TEST_GROUP)),1)
$(error RELIEFOS_CI_TEST_GROUP must be all or core)
endif
ifeq ($(filter all core,$(RELIEFOS_CI_TEST_GROUP)),)
$(error RELIEFOS_CI_TEST_GROUP must be all or core; use test-ci-kernel/auth/pages for focused groups)
endif
RELIEFOS_CI_SELECTOR := $(RELIEFOS_SRC)/tools/ci_test_shards.py
define RELIEFOS_CI_SELECT_TESTS
$(eval reliefos_ci_selected := $(shell $(RELIEFOS_TEST_PYTHON) '$(RELIEFOS_CI_SELECTOR)' --root '$(RELIEFOS_SRC)' --group $(1) || echo __CI_SHARD_ERROR__))$(if $(filter __CI_SHARD_ERROR__,$(reliefos_ci_selected)),$(error CI test shard validation failed),$(addprefix $(RELIEFOS_SRC)/tests/build/,$(reliefos_ci_selected)))
endef
RELIEFOS_SELECTED_BUILD_TESTS := $(RELIEFOS_BUILD_TESTS)
ifeq ($(RELIEFOS_CI_TEST_GROUP),core)
# Select only when the contract-test recipe needs the inventory. Other goals
# may forward a guest/kernel Python path that is not a host interpreter.
RELIEFOS_SELECTED_BUILD_TESTS = $(call RELIEFOS_CI_SELECT_TESTS,core)
endif
ifneq ($(filter test-ci-kernel test-ci-auth test-ci-pages test-ci-validate,$(MAKECMDGOALS)),)
# Validate while parsing, before any expensive prerequisite can start.
reliefos_ci_validated := $(call RELIEFOS_CI_SELECT_TESTS,all)
endif
# Suites that are too long to run on every change but must not be forgotten:
# repeated -j1/-j8 comparisons and, later, guest boots. Plan section 13 forbids
# presenting an unrun long test as a skipped pass, so they are a separate goal.
RELIEFOS_LONG_TESTS := $(sort $(wildcard $(RELIEFOS_SRC)/tests/long/test-*.sh))

# The plain and sanitised suites are separate goals so `test-tools` keeps a
# single recipe: the plan requires ASan/UBSan at the tool boundary, not merely a
# clean compile.
.PHONY: reliefos-test-tools-plain reliefos-test-tools-sanitised \
	leonos-test-tools-plain leonos-test-tools-sanitised

test-tools: reliefos-test-tools-plain reliefos-test-tools-sanitised

reliefos-test-tools-plain: $(RELIEFOS_HOST_TEST_BINS)
	@set -eu; for test_binary in $(RELIEFOS_HOST_TEST_BINS); do \
	    $(call RELIEFOS_LOG_SHELL,RUN,$$test_binary); \
	    $$test_binary; \
	done

reliefos-test-tools-sanitised: $(RELIEFOS_HOST_TEST_SANITISED)
	@set -eu; for test_binary in $(RELIEFOS_HOST_TEST_SANITISED); do \
	    $(call RELIEFOS_LOG_SHELL,RUN,$$test_binary); \
	    ASAN_OPTIONS=detect_leaks=1 \
	    UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 $$test_binary; \
	done

# Contract tests get the built tool and the lock file by name so they never
# reach for a stale copy left in the output tree.
#
# A suite can report ok lines while still exiting 0 on a failure it counted
# itself, and it can exit non-zero after printing nothing. Both are checked: the
# status *and* any `FAIL - ` line in the captured report.
#
# $(call RELIEFOS_RUN_CONTRACT_TESTS,tests...)
# The recursive recipe prefix keeps jobserver descriptors open for the scripts'
# submakes. Stop before creating fixtures under dry-run, query or touch mode.
define RELIEFOS_RUN_CONTRACT_TESTS
	set -eu; case "$${MAKEFLAGS%% *}" in *[nqt]*) exit 0;; esac; \
	for contract_test in $(1); do \
	    $(call RELIEFOS_LOG_SHELL,RUN,$$contract_test); \
	    started=$$(date +%s); \
	    report=$$(mktemp); \
	    if RELIEFOS_DEPS='$(abspath $(RELIEFOS_DEPS_TOOL))' \
	       LEONOS_DEPS='$(abspath $(RELIEFOS_DEPS_TOOL))' \
	       RELIEFOS_LOCK='$(RELIEFOS_SRC)/configs/dependencies.lock.json' \
	       LEONOS_LOCK='$(RELIEFOS_SRC)/configs/dependencies.lock.json' \
	       RELIEFOS_CACHE='$(abspath $(RELIEFOS_CACHE))' \
	       GRUB_HOST_ROOT='$(GRUB_HOST_ROOT)' \
	       GRUB_EFI_DIR='$(GRUB_EFI_DIR)' \
	       RELIEFOS_EMIT='$(abspath $(RELIEFOS_EMIT))' \
	       LEONOS_EMIT='$(abspath $(RELIEFOS_EMIT))' \
	       RELIEFOS_TEST_BUSYBOX='$(abspath $(INITRAMFS_BUSYBOX_ELF))' \
	       RELIEFOS_KERNEL_TOOLS='$(abspath $(RELIEFOS_KERNEL_TOOLS))' \
	       RELIEFOS_TEST_RECOVERY='$(abspath $(RELIEFOS_KERNEL_RECOVERY))' \
	       RELIEFOS_TEST_HEADERS='$(abspath $(HEADER_EXPORT_INCLUDE))' \
	       sh $$contract_test >$$report 2>&1; then status=0; else status=1; fi; \
	    cat $$report; \
	    printf 'TIME - %s: %ss\n' "$${contract_test##*/}" "$$(($$(date +%s) - started))"; \
	    if grep -q 'FAIL - ' $$report; then status=1; fi; \
	    rm -f $$report; \
	    if [ $$status -ne 0 ]; then \
	        printf 'not ok - %s reported a failure\n' $$contract_test; exit 1; \
	    fi; \
	done
endef

# Keep the former private goal names available to scripts during the rename.
leonos-test-tools-plain: reliefos-test-tools-plain
leonos-test-tools-sanitised: reliefos-test-tools-sanitised

test-build: sdk rootfs-raw $(HOST_RUNTIME_DEVELOPMENT_PRODUCTS) test-tools $(RELIEFOS_HOST_TOOLS) $(INITRAMFS_BUSYBOX_ELF) $(INITRAMFS_BUSYBOX_LINKS) $(RELIEFOS_KERNEL_RECOVERY) $(HEADER_EXPORT_MANIFEST)
	+@$(call RELIEFOS_RUN_CONTRACT_TESTS,$(RELIEFOS_SELECTED_BUILD_TESTS))
	@$(RELIEFOS_TEST_PYTHON) $(RELIEFOS_SRC)/tools/test_xorg_qemu.py --source-only

# The signed Installer update fixtures use the real APK producer and installed
# Bash. Require the managed tree explicitly so a clean `make test-build` has
# the same inputs as CI after its image build.
test-build: $(UPSTREAM_APK) $(APK_MANAGED_ROOT)/.apk-complete

.PHONY: test-ci-validate test-ci-kernel test-ci-auth test-ci-pages
test-ci-validate:
	@$(RELIEFOS_TEST_PYTHON) '$(RELIEFOS_CI_SELECTOR)' --root '$(RELIEFOS_SRC)' --check

# These contracts build their own disposable outputs; staging the complete
# SDK/rootfs first would duplicate the image build for every CI shard.
test-ci-kernel test-ci-auth: test-ci-validate $(RELIEFOS_HOST_TOOLS)
	+@$(call RELIEFOS_RUN_CONTRACT_TESTS,$(call RELIEFOS_CI_SELECT_TESTS,$(patsubst test-ci-%,%,$@)))

# Pages uses the real native module/initramfs producers and static verifier.
test-ci-pages: test-ci-validate $(RELIEFOS_HOST_TOOLS) $(INITRAMFS_BUSYBOX_ELF) $(INITRAMFS_BUSYBOX_LINKS) $(RELIEFOS_KERNEL_RECOVERY)
	+@$(call RELIEFOS_RUN_CONTRACT_TESTS,$(call RELIEFOS_CI_SELECT_TESTS,pages))

test-long: $(RELIEFOS_HOST_TOOLS) grub-host grub-efi
	+@$(call RELIEFOS_RUN_CONTRACT_TESTS,$(RELIEFOS_LONG_TESTS))

# Audio userland is an explicit host gate because it needs the staged ALSA and
# Nuked OPL3 products.  Keep it separate from the generic shell suite so a
# missing audio staging tree is reported as a real prerequisite failure rather
# than silently skipped.
.PHONY: test-audio
test-audio:
	@python3 $(RELIEFOS_SRC)/tools/test_audio_userland.py controls settings doom-output doom-mixer doom-music

test: test-tools test-build test-system-update test-kernel-update test-boot-health

.PHONY: test-directory-api
test-directory-api:
	$(Q)python3 $(RELIEFOS_SRC)/tools/test_directory_api.py

test: test-directory-api

# Installer navigation and deferred partition editing must stay in the normal
# host gate: these exercise real GPT images without touching host devices.
.PHONY: test-installer-flow
test-installer-flow: $(HOST_RUNTIME_DEVELOPMENT_PRODUCTS)
	$(Q)PYTHONDONTWRITEBYTECODE=1 $(RELIEFOS_TEST_PYTHON) $(RELIEFOS_SRC)/tools/test_installer_plan.py
	$(Q)PYTHONDONTWRITEBYTECODE=1 $(RELIEFOS_TEST_PYTHON) $(RELIEFOS_SRC)/tools/test_installer_setup.py
	$(Q)PYTHONDONTWRITEBYTECODE=1 $(RELIEFOS_TEST_PYTHON) $(RELIEFOS_SRC)/tools/test_installer_input.py

test: test-installer-flow

# Kernel implementation tests are owned and selected by ReliefNT. The parent
# preserves convenient Make goals and delegates; it owns no kernel suite list.
RELIEFOS_KERNEL_TEST_GOALS := test-vdso test-smp-time test-page-cache-growth \
 test-user-return test-syscall-io test-kernel-host test-kernel-ownership
.PHONY: $(RELIEFOS_KERNEL_TEST_GOALS)
$(RELIEFOS_KERNEL_TEST_GOALS):
	$(Q)mkdir -p $(O)/tmp/kernel-tests
	+$(Q)$(RELIEFNT_CONFIG_ENV) $(MAKE) -C '$(RELIEFNT_DIR)' O='$(abspath $(O))/kernel-tests/$@' \
	 TMPDIR='$(or $(TMPDIR),$(abspath $(O))/tmp/kernel-tests)' \
	 RELIEFNT_TEST_PYTHON='$(or $(RELIEFOS_TEST_PYTHON),python3)' \
	 $(patsubst test-kernel-%,test-%,$@)

# Each instrumentation mode has its own native output context. Sources and
# generated dependency files are never shared across the two compiler policies.
define RELIEFOS_NATIVE_HOST_TESTS
.PHONY: native-host-tests-$(1)
native-host-tests-$(1):
	$$(Q)mkdir -p $(2)
	+$$(Q)$$(MAKE) --no-print-directory -C $(2) $$(build)=scripts/basic \
	 KBUILD_HOSTCFLAGS='-O2 -I$$(srctree)/scripts/include' HOSTCC='$$(HOSTCC)'
	+$$(Q)$$(MAKE) --no-print-directory -C $(2) $$(build)=. \
	 kbuild-file='$$(srctree)/tests/host/Kbuild' HOSTCC='$$(HOSTCC)' \
	 KBUILD_HOSTCFLAGS='$$(RELIEFOS_STRICT_WARNINGS) $$(RELIEFOS_HOST_INCLUDES) $(3) -I$$(srctree)/userland/runtime/src' \
	 KBUILD_HOSTLDFLAGS='$$(HOST_LDFLAGS) $(4)'
$(addprefix $(2)/,test_common test_json test_locale_conf): native-host-tests-$(1) ;
endef
$(eval $(call RELIEFOS_NATIVE_HOST_TESTS,plain,$(O_HOST)/tests,$(HOST_CFLAGS),))
$(eval $(call RELIEFOS_NATIVE_HOST_TESTS,sanitised,$(O_HOST)/tests-sanitised,$(RELIEFOS_SANITISE) -g -O1,$(RELIEFOS_SANITISE) -g -O1))
.PHONY: test test-tools test-build test-long

.PHONY: test-reliefapk
.PHONY: test-openrc-controller
.PHONY: test-network-controller
test-network-controller: $(HEADER_EXPORT_MANIFEST)
	$(Q)TMPDIR='$(abspath $(O))/tmp' RELIEFOS_TEST_HEADERS='$(abspath $(HEADER_EXPORT_INCLUDE))' sh $(RELIEFOS_SRC)/tests/build/test-network-controller.sh

test-openrc-controller:
	$(Q)TMPDIR='$(abspath $(O))/tmp' sh $(RELIEFOS_SRC)/tests/build/test-openrc-controller.sh

test-reliefapk:
	$(Q)TMPDIR='$(abspath $(O))/tmp' sh $(RELIEFOS_SRC)/tests/build/test-reliefapk-model.sh
	$(Q)TMPDIR='$(abspath $(O))/tmp' sh $(RELIEFOS_SRC)/tests/build/test-reliefapk-process.sh
	$(Q)TMPDIR='$(abspath $(O))/tmp' sh $(RELIEFOS_SRC)/tests/build/test-reliefapk-repositories.sh

.PHONY: test-reliefapk-apk
test-reliefapk-apk: $(UPSTREAM_APK)
	$(Q)TMPDIR='$(abspath $(O))/tmp' python3 $(RELIEFOS_SRC)/tools/tests/test_reliefapk_apk.py --apk $(abspath $(UPSTREAM_APK))

.PHONY: test-system-update
test-system-update: $(USERLAND_DIR)/systemupdate.elf $(INITRAMFS_BUSYBOX_ELF) $(UPSTREAM_APK) $(HOST_RUNTIME_DEVELOPMENT_PRODUCTS)
	$(Q)mkdir -p '$(abspath $(O))/tmp'
	$(Q)TMPDIR='$(abspath $(O))/tmp' RELIEFOS_TEST_SYSTEM_UPDATE='$(abspath $(USERLAND_DIR))/systemupdate.elf' \
	 RELIEFOS_TEST_BUSYBOX='$(abspath $(INITRAMFS_BUSYBOX_ELF))' RELIEFOS_TEST_APK='$(abspath $(UPSTREAM_APK))' \
	 $(RELIEFOS_TEST_PYTHON) $(RELIEFOS_SRC)/tools/test_system_update.py
	$(Q)TMPDIR='$(abspath $(O))/tmp' $(RELIEFOS_TEST_PYTHON) $(RELIEFOS_SRC)/tools/tests/test_system_update_packaging.py --apk '$(abspath $(UPSTREAM_APK))'
	$(Q)TMPDIR='$(abspath $(O))/tmp' RELIEFOS_TEST_BUSYBOX='$(abspath $(INITRAMFS_BUSYBOX_ELF))' \
	 RELIEFOS_TEST_APK='$(abspath $(UPSTREAM_APK))' $(RELIEFOS_TEST_PYTHON) $(RELIEFOS_SRC)/tools/test_system_update_sanitizers.py

.PHONY: test-kernel-update
test-kernel-update: $(HOST_RUNTIME_DEVELOPMENT_PRODUCTS) $(RELIEFOS_KERNEL_TOOLS) $(RELIEFOS_KERNEL_RECOVERY) $(USERLAND_DIR)/bootinstall.elf $(USERLAND_DIR)/systemupdate.elf $(USERLAND_DIR)/rprfetch.elf $(INITRAMFS_BUSYBOX_ELF) $(UPSTREAM_APK)
	$(Q)mkdir -p '$(abspath $(O))/tmp'
	$(Q)TMPDIR='$(abspath $(O))/tmp' RELIEFOS_KERNEL_TOOLS='$(abspath $(RELIEFOS_KERNEL_TOOLS))' \
	 RELIEFOS_TEST_RECOVERY='$(abspath $(RELIEFOS_KERNEL_RECOVERY))' \
	 RELIEFOS_TEST_BOOTINSTALL='$(abspath $(USERLAND_DIR))/bootinstall.elf' \
	 RELIEFOS_TEST_SYSTEM_UPDATE='$(abspath $(USERLAND_DIR))/systemupdate.elf' \
	 RELIEFOS_TEST_BUSYBOX='$(abspath $(INITRAMFS_BUSYBOX_ELF))' RELIEFOS_TEST_APK='$(abspath $(UPSTREAM_APK))' \
	 $(RELIEFOS_TEST_PYTHON) $(RELIEFOS_SRC)/tools/test_kernel_update.py

.PHONY: test-boot-health
test-boot-health: grub-host grub-efi
	$(Q)mkdir -p '$(abspath $(O))/tmp'
	$(Q)set -eu; output=$$(mktemp -d '$(abspath $(O))/tmp/boot-health.XXXXXX'); rmdir "$$output"; \
	 $(RELIEFOS_TEST_PYTHON) $(RELIEFOS_SRC)/tools/test_boot_health_qemu.py --output "$$output" \
	 --grub-host '$(abspath $(GRUB_HOST_ROOT))' --grub-efi '$(abspath $(GRUB_EFI_DIR))'
