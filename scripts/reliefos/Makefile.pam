# Linux-PAM is built with the audited project Make adapter, without Meson.
PAM_ROOT := $(O)/pam/root
PAM_WORK := $(O_THIRD_PARTY)/pam
PAM_STAMP := $(O)/pam/.complete
PAM_PORT := $(RELIEFOS_SRC)/tools/build/pam
PAM_LIB := $(PAM_ROOT)/lib/libpam.so.0
PAM_HEADER := $(PAM_ROOT)/usr/include/security/pam_appl.h
PAM_RELIEFOS_MODULE := $(PAM_ROOT)/lib/security/pam_leonos_password.so
PAM_INPUTS := $(PAM_PORT)/Makefile $(PAM_PORT)/configure.sh $(PAM_PORT)/install.sh $(wildcard $(RELIEFOS_SRC)/patches/linux-pam/*.patch)
RELIEFOS_PARAMETERS_pam := compiler=$(TARGET_CC)|target=$(TRIPLE_USER)|identity=$(shell $(TARGET_CC) --version 2>/dev/null | head -n1)
$(if $(RELIEFOS_PASSIVE),,$(eval $(call KBUILD_PARAMETERS,pam)))

$(PAM_STAMP) $(PAM_LIB) $(PAM_HEADER) &: $(AUTH_STAMP) $(RELIEFOS_AUTH_ARTIFACTS) $(MUSL_STAMP) $(RELIEFOS_LOCK) $(PAM_INPUTS) $(HEADER_EXPORT_MANIFEST) $(RELIEFOS_SRC)/tools/build/pam-stage.sh $(RELIEFOS_UPSTREAM_MAKE_ENV) $(O_META)/pam.parameters
	$(Q)mkdir -p $(dir $(PAM_STAMP)) $(O_LOGS)
	+$(Q)case "$${MAKEFLAGS%% *}" in *n*) exit 0;; esac; UPSTREAM_UAPI='$(abspath $(HEADER_EXPORT_INCLUDE))' sh $(RELIEFOS_SRC)/tools/build/pam-stage.sh $(RELIEFOS_SRC) $(abspath $(RELIEFOS_DEPS_TOOL)) $(RELIEFOS_LOCK) $(RELIEFOS_CACHE) \
	 $(abspath $(PAM_WORK)) $(abspath $(PAM_ROOT)) $(abspath $(MUSL_SYSROOT)) $(abspath $(AUTH_ROOT)) $(TARGET_CC) $(TRIPLE_USER) \
	 >$(O_LOGS)/pam.log 2>&1 || { tail -n 40 $(O_LOGS)/pam.log >&2; exit 1; }
	$(Q)touch $(PAM_STAMP)
	$(Q)touch $(PAM_LIB) $(PAM_HEADER)

PAM_CFLAGS := --target=$(TRIPLE_USER) --sysroot=$(MUSL_SYSROOT) --gcc-toolchain=/nonexistent -fuse-ld=lld --rtlib=compiler-rt --unwindlib=none -O2 -fPIC -nostdinc -isystem $(MUSL_SYSROOT)/include -isystem $(shell $(TARGET_CC) -print-resource-dir 2>/dev/null)/include -I$(PAM_ROOT)/usr/include -I$(HEADER_EXPORT_INCLUDE) -I$(RELIEFOS_SRC)/include -ffile-prefix-map=$(RELIEFOS_SRC)=.
PAM_LINK_FLAGS := $(PAM_CFLAGS) -shared -Wl,-z,relro,-z,now,--no-undefined
RELIEFOS_CAPTURE_PAM_KBUILD := 1
include $(RELIEFOS_SRC)/userland/pam/Kbuild
RELIEFOS_CAPTURE_PAM_KBUILD :=
PAM_OBJECTS := $(addprefix $(O)/userland/pam/,$(RELIEFOS_PAM_OBJECTS))
obj-y += userland/pam/
export PAM_CFLAGS
userland/pam: $(PAM_STAMP) $(PAM_HEADER) $(MUSL_STAMP) $(HEADER_EXPORT_MANIFEST) $(RELIEFOS_CC_ID) $(RELIEFOS_AR_ID)

quiet_cmd_reliefos_pam_module = LD      $@
      cmd_reliefos_pam_module = mkdir -p $(dir $@); $(TARGET_CC) $(PAM_LINK_FLAGS) $(PAM_OBJECTS) -L$(PAM_ROOT)/lib -lpam -o $@.tmp; mv $@.tmp $@
$(PAM_RELIEFOS_MODULE): $(O)/userland/pam/built-in.a $(PAM_LIB) $(PAM_STAMP) $(RELIEFOS_CC_ID) FORCE
	$(call if_changed,reliefos_pam_module)
targets += $(PAM_RELIEFOS_MODULE)

.PHONY: reliefos-pam leonos-pam
reliefos-pam: $(PAM_STAMP) $(PAM_LIB) $(PAM_HEADER) $(PAM_RELIEFOS_MODULE)
leonos-pam: reliefos-pam
