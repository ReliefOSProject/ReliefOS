# QEMU policy follows Kconfig; command-line variables override local defaults.
QEMU ?= qemu-system-x86_64
QEMU_BOOT ?= uefi
QEMU_FIRMWARE ?= $(or $(wildcard $(subst ",,$(CONFIG_QEMU_OVMF_PATH))),$(firstword $(wildcard /usr/share/edk2/x64/OVMF.4m.fd /usr/share/ovmf/OVMF.fd /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/qemu/OVMF.fd)))
ifeq ($(QEMU_BOOT),bios)
QEMU_FIRMWARE_FLAGS :=
else ifeq ($(QEMU_BOOT),uefi)
QEMU_FIRMWARE_FLAGS := -bios $(QEMU_FIRMWARE)
else
$(error QEMU_BOOT must be uefi or bios)
endif
QEMU_DISPLAY ?= gtk,grab-on-hover=on,show-cursor=on
QEMU_GPU ?= vga
ifeq ($(QEMU_GPU),vga)
QEMU_GPU_FLAGS := -vga none -device VGA,xres=$(or $(CONFIG_QEMU_DISPLAY_WIDTH),1920),yres=$(or $(CONFIG_QEMU_DISPLAY_HEIGHT),1080)
else ifeq ($(QEMU_GPU),virtio)
QEMU_GPU_FLAGS := -vga none -device virtio-vga
else ifeq ($(QEMU_GPU),virgl)
QEMU_GPU_FLAGS := -vga none -device virtio-vga-gl
ifeq ($(origin QEMU_DISPLAY),file)
QEMU_DISPLAY := gtk,gl=on
endif
else
$(error QEMU_GPU must be vga, virtio or virgl)
endif
QEMU_SERIAL ?= stdio
QEMU_AUDIO ?= sdl
QEMU_SOUND_DEVICE ?= hda
ifeq ($(QEMU_SOUND_DEVICE),hda)
QEMU_SOUND_FLAGS := -device intel-hda,msi=auto -device hda-duplex,audiodev=snd0
else ifeq ($(QEMU_SOUND_DEVICE),ac97)
QEMU_SOUND_FLAGS := -device AC97,audiodev=snd0
else ifeq ($(QEMU_SOUND_DEVICE),es1371)
QEMU_SOUND_FLAGS := -device ES1370,audiodev=snd0
else ifeq ($(QEMU_SOUND_DEVICE),none)
QEMU_SOUND_FLAGS :=
else
$(error QEMU_SOUND_DEVICE must be hda, ac97, es1371 or none)
endif
QEMU_KVM ?= $(if $(filter y,$(CONFIG_QEMU_ENABLE_KVM)),1,0)
RELIEFOS_QEMU_IDE ?= $(LEONOS_QEMU_IDE)
RELIEFOS_QEMU_NVME ?= $(LEONOS_QEMU_NVME)
QEMU_MEMORY := $(or $(MEMORY),$(CONFIG_QEMU_MEMORY_MB),4096)
QEMU_CPUS := $(or $(CPUS),$(CONFIG_QEMU_SMP_CPUS),4)
comma := ,
QEMU_INSTALLER_DISK ?=
QEMU_INSTALLER_DISK_FORMAT ?= qcow2
QEMU_NETWORK := $(subst ",,$(CONFIG_QEMU_NET_DEVICE))
QEMU_NETWORK_FLAGS := $(if $(QEMU_NETWORK),-netdev user$(comma)id=net0 -device $(QEMU_NETWORK)$(comma)netdev=net0)
ifneq ($(strip $(QEMU_INSTALLER_DISK)),)
QEMU_INSTALLER_DISK_PATH := $(if $(filter /%,$(QEMU_INSTALLER_DISK)),$(QEMU_INSTALLER_DISK),$(RELIEFOS_SRC)/$(QEMU_INSTALLER_DISK))
QEMU_INSTALLER_DISK_CHECK := test -f '$(QEMU_INSTALLER_DISK_PATH)' || { echo 'missing installer target disk: $(QEMU_INSTALLER_DISK_PATH)' >&2; exit 1; }
QEMU_INSTALLER_DISK_FLAGS := -drive file=$(QEMU_INSTALLER_DISK_PATH)$(comma)if=none$(comma)id=installer-disk$(comma)format=$(QEMU_INSTALLER_DISK_FORMAT) -device ich9-ahci$(comma)id=installer-ahci -device ide-hd$(comma)drive=installer-disk$(comma)bus=installer-ahci.0
endif
QEMU_FLAGS := -machine $(if $(filter 1 y yes true,$(RELIEFOS_QEMU_IDE)),pc,q35) $(if $(filter 1,$(QEMU_KVM)),-enable-kvm -cpu host,-cpu max) -m $(QEMU_MEMORY) -smp $(QEMU_CPUS) $(QEMU_FIRMWARE_FLAGS) -display $(QEMU_DISPLAY) -serial $(QEMU_SERIAL) $(QEMU_GPU_FLAGS) $(QEMU_NETWORK_FLAGS) -audiodev $(QEMU_AUDIO),id=snd0 $(QEMU_SOUND_FLAGS)
QEMU_DISK := -drive file=$(DISK_VMDK),if=none,id=disk0,format=vmdk
ifneq ($(filter 1 y yes true,$(RELIEFOS_QEMU_NVME)),)
QEMU_DISK += -device nvme,drive=disk0,serial=leonosnvme
else ifneq ($(filter 1 y yes true,$(RELIEFOS_QEMU_IDE)),)
QEMU_DISK += -device piix3-ide,id=ide -device ide-hd,drive=disk0,bus=ide.0,unit=0
else
QEMU_DISK += -device ich9-ahci,id=ahci -device ide-hd,drive=disk0,bus=ahci.0
endif
QEMU_RUN_DISK ?=
QEMU_RUN_DISK_FORMAT ?= qcow2
ifneq ($(strip $(QEMU_RUN_DISK)),)
QEMU_RUN_DISK_PATH := $(if $(filter /%,$(QEMU_RUN_DISK)),$(QEMU_RUN_DISK),$(RELIEFOS_SRC)/$(QEMU_RUN_DISK))
QEMU_RUN_DISK_CHECK := test -f '$(QEMU_RUN_DISK_PATH)' || { echo 'missing run disk: $(QEMU_RUN_DISK_PATH)' >&2; exit 1; }
QEMU_RUN_DISK_FLAGS := -drive file=$(QEMU_RUN_DISK_PATH)$(comma)if=none$(comma)id=run-disk$(comma)format=$(QEMU_RUN_DISK_FORMAT) -device ich9-ahci$(comma)id=run-ahci -device ide-hd$(comma)drive=run-disk$(comma)bus=run-ahci.0
else
QEMU_RUN_DISK_CHECK := test -f '$(DISK_VMDK)' || { echo 'missing disk image: $(DISK_VMDK)' >&2; exit 1; }
QEMU_RUN_DISK_FLAGS := $(QEMU_DISK)
endif
.PHONY: run run-debug run-iso run-installer run-only run-installer-only run-iso-only
run run-debug: image-vmdk
	$(Q)test '$(QEMU_BOOT)' = bios || test -f '$(QEMU_FIRMWARE)' || { echo 'set QEMU_FIRMWARE to an OVMF firmware image' >&2; exit 1; }
	$(Q)$(QEMU) $(QEMU_FLAGS) $(QEMU_DISK) $(if $(filter run-debug,$@),-no-reboot -no-shutdown)
run-iso: iso
	$(Q)test '$(QEMU_BOOT)' = bios || test -f '$(QEMU_FIRMWARE)'
	$(Q)$(QEMU) $(QEMU_FLAGS) -cdrom $(LIVE_ISO) -no-reboot -no-shutdown
run-installer: installer
	$(Q)test '$(QEMU_BOOT)' = bios || test -f '$(QEMU_FIRMWARE)'
	$(Q)$(QEMU) $(QEMU_FLAGS) $(QEMU_INSTALLER_DISK_FLAGS) -cdrom $(INSTALLER_ISO) -no-reboot -no-shutdown

# These entry points consume existing images only; they deliberately have no
# image-vmdk/iso/installer prerequisites.
run-only:
	$(Q)$(QEMU_RUN_DISK_CHECK)
	$(Q)test '$(QEMU_BOOT)' = bios || test -f '$(QEMU_FIRMWARE)' || { echo 'set QEMU_FIRMWARE to an OVMF firmware image' >&2; exit 1; }
	$(Q)$(QEMU) $(QEMU_FLAGS) $(QEMU_RUN_DISK_FLAGS)

run-iso-only:
	$(Q)test -f '$(LIVE_ISO)' || { echo 'missing live ISO: $(LIVE_ISO)' >&2; exit 1; }
	$(Q)test '$(QEMU_BOOT)' = bios || test -f '$(QEMU_FIRMWARE)' || { echo 'set QEMU_FIRMWARE to an OVMF firmware image' >&2; exit 1; }
	$(Q)$(QEMU) $(QEMU_FLAGS) -cdrom $(LIVE_ISO) -no-reboot -no-shutdown

run-installer-only:
	$(Q)test -f '$(INSTALLER_ISO)' || { echo 'missing installer ISO: $(INSTALLER_ISO)' >&2; exit 1; }
	$(Q)$(QEMU_INSTALLER_DISK_CHECK)
	$(Q)test '$(QEMU_BOOT)' = bios || test -f '$(QEMU_FIRMWARE)' || { echo 'set QEMU_FIRMWARE to an OVMF firmware image' >&2; exit 1; }
	$(Q)$(QEMU) $(QEMU_FLAGS) $(QEMU_INSTALLER_DISK_FLAGS) -cdrom $(INSTALLER_ISO) -no-reboot -no-shutdown
