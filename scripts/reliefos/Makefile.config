# Native Linux Kconfig configuration and output membership.
KCONFIG_SEED := $(srctree)/configs/default.conf
KCONFIG_ROOT := $(srctree)/Kconfig
RELIEFOS_CONFIG_FILE := .config
KCONFIG_CONFIG := $(RELIEFOS_CONFIG_FILE)
KCONFIG_CONF := scripts/kconfig/conf
KCONFIG_MCONF := scripts/kconfig/mconf
AUTOCONF_H := include/generated/autoconf.h
AUTOCONF_INSTALLER_H := include/generated/autoconf-installer.h
RELIEFOS_POLICY_HEADER := $(srctree)/userland/runtime/include/build_policy.h
COMPONENT_SELECTION := $(O_GENERATED)/component-selection.json
LEX := flex
YACC := bison
export KCONFIG_CONFIG LEX YACC

.PHONY: native-conf native-mconf defconfig olddefconfig menuconfig
native-conf:
	+$(Q)$(MAKE) $(build)=scripts/kconfig build_config HOSTCC='$(HOSTCC)' \
	 KBUILD_HOSTCFLAGS='-O2 -I$(srctree)/scripts/include' LEX='$(LEX)' YACC='$(YACC)'
native-mconf:
	+$(Q)$(MAKE) $(build)=scripts/kconfig build_menuconfig HOSTCC='$(HOSTCC)' \
	 KBUILD_HOSTCFLAGS='-O2 -I$(srctree)/scripts/include' LEX='$(LEX)' YACC='$(YACC)'
$(KCONFIG_CONF): | native-conf ;
$(KCONFIG_MCONF): | native-mconf ;

defconfig: $(KCONFIG_CONF)
	$(Q)$(KCONFIG_CONF) --defconfig=$(KCONFIG_SEED) $(KCONFIG_ROOT)
	$(Q)$(KCONFIG_CONF) --syncconfig $(KCONFIG_ROOT)
olddefconfig: $(KCONFIG_CONF)
	$(Q)$(KCONFIG_CONF) --olddefconfig $(KCONFIG_ROOT)
	$(Q)$(KCONFIG_CONF) --syncconfig $(KCONFIG_ROOT)
menuconfig: $(KCONFIG_MCONF) $(KCONFIG_CONF)
	$(Q)$(KCONFIG_MCONF) $(KCONFIG_ROOT)
	$(Q)$(KCONFIG_CONF) --syncconfig $(KCONFIG_ROOT)

ifeq ($(RELIEFOS_PASSIVE)$(RELIEFOS_INSPECT),)
$(RELIEFOS_CONFIG_FILE):
	+$(Q)$(MAKE) $(build)=scripts/kconfig build_config HOSTCC='$(HOSTCC)' \
	 KBUILD_HOSTCFLAGS='-O2 -I$(srctree)/scripts/include' LEX='$(LEX)' YACC='$(YACC)'
	$(Q)$(KCONFIG_CONF) --defconfig=$(KCONFIG_SEED) $(KCONFIG_ROOT)
include/config/auto.conf include/config/auto.conf.cmd include/generated/autoconf.h &: $(RELIEFOS_CONFIG_FILE) $(KCONFIG_ROOT) $(srctree)/Kconfig.components
	+$(Q)$(MAKE) $(build)=scripts/kconfig build_config HOSTCC='$(HOSTCC)' \
	 KBUILD_HOSTCFLAGS='-O2 -I$(srctree)/scripts/include' LEX='$(LEX)' YACC='$(YACC)'
	$(Q)$(KCONFIG_CONF) --syncconfig $(KCONFIG_ROOT)
-include include/config/auto.conf.cmd
endif

filechk_installer_policy = printf '%s\n' \
 '$(pound)ifndef RELIEFOS_AUTOCONF_INSTALLER_H' '$(pound)define RELIEFOS_AUTOCONF_INSTALLER_H' \
 '$(pound)include <generated/autoconf.h>' '$(pound)undef RELIEFOS_LICENSE_REQUIRE' \
 '$(pound)ifdef CONFIG_INSTALLER_INSTALLED_REQUIRE_LICENSE' '$(pound)define RELIEFOS_LICENSE_REQUIRE 1' \
 '$(pound)else' '$(pound)define RELIEFOS_LICENSE_REQUIRE 0' '$(pound)endif' '$(pound)endif'
$(AUTOCONF_INSTALLER_H): FORCE
	$(call filechk,installer_policy)

.PHONY: migrate-config regen-component-kconfig
migrate-config:
	@test -f '$(RELIEFOS_CONFIG_FILE)'
	$(Q)sh $(srctree)/tools/build/reliefos-config-migrate.sh --in-place '$(RELIEFOS_CONFIG_FILE)'
regen-component-kconfig:
	$(Q)python3 $(srctree)/tools/generate_component_kconfig.py
