#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Freeze a signed APK cohort, validate its complete kernel bundle, then let APK
# and the shared native publisher own installation, retention and activation.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
usage() { echo 'Usage: reliefos-kernel-update [-f|--force|--check]' >&2; }
die() { printf 'reliefos-kernel-update: %s\n' "$1" >&2; exit 1; }
check_only=0
force=0
case ${1-} in
    '') ;;
    --check) check_only=1 ;;
    -f|--force) force=1 ;;
    *) usage; exit 2 ;;
esac
[ "$#" -le 1 ] || { usage; exit 2; }
[ "$check_only" = 1 ] || [ "$(id -u)" = 0 ] || die 'root privileges are required'
config=/etc/reliefos/rpr.conf
[ -r "$config" ] || die 'Missing RPR configuration'
rpr_url=$(sed -n 's/^RPR_BASE_URL=//p' "$config")
case $rpr_url in
    https://*) ;;
    *) die 'Invalid RPR URL: HTTPS is required' ;;
esac
case $rpr_url in *[[:space:]]*|*\?*|*\#*) die 'Invalid RPR URL' ;; esac
rpr_url=${rpr_url%/}
helper=/usr/libexec/reliefos/kernel-bundle
temporary=$(mktemp -d "${TMPDIR:-/tmp}/reliefos-kernel-update.XXXXXX") || exit 1
lock_dir=
legacy_lock_dir=
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    rm -rf -- "$temporary"
    [ -z "$lock_dir" ] || rmdir -- "$lock_dir" 2>/dev/null || true
    [ -z "$legacy_lock_dir" ] || rmdir -- "$legacy_lock_dir" 2>/dev/null || true
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM
manifest=$temporary/release.txt
rprfetch "$rpr_url/kernel/release.txt" "$manifest"
[ "$(wc -c < "$manifest")" -le 4096 ] || die 'Oversized kernel release manifest'
# Never source metadata. Refuse NUL, CR, spaces and all executable syntax before
# parsing the exact bounded key set; every field is a single scalar.
tr -d '[:alnum:]_.+=/\n-' < "$manifest" > "$temporary/invalid"
[ ! -s "$temporary/invalid" ] || die 'Invalid kernel release manifest bytes'
field() { sed -n "s/^$1=//p" "$manifest"; }
format=$(field format_version)
[ "$format" = 4 ] || die "Unsupported kernel release manifest: $format; a complete format 4 package is required"
awk -F= '
    BEGIN { split("format_version image_version version kernel_release module_abi kernel_sha256 initramfs_sha256 package package_version package_file package_sha256 repository_sha256 bundle_manifest_sha256 module_directory", keys, " "); for (i in keys) allowed[keys[i]]=1 }
    NF != 2 || !allowed[$1] || seen[$1]++ || $2 == "" { exit 1 }
    END { if (NR != 14) exit 1 }
' "$manifest" || die 'Invalid or duplicate kernel release fields'
remote_image=$(field image_version)
remote_version=$(field version)
release=$(field kernel_release)
abi=$(field module_abi)
kernel_hash=$(field kernel_sha256)
initramfs_hash=$(field initramfs_sha256)
package_version=$(field package_version)
package_file=$(field package_file)
package_hash=$(field package_sha256)
index_hash=$(field repository_sha256)
bundle_hash=$(field bundle_manifest_sha256)
printf '%s\n' "$remote_image" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || die 'Invalid remote image version'
[ "${#remote_image}" -le 31 ] && [ "$remote_image" = "$remote_version" ] || die 'Remote image and release versions disagree'
case $release in ''|.|..|*[!A-Za-z0-9._+-]*) die 'Invalid kernel release identity' ;; esac
[ "${#release}" -le 31 ] || die 'Invalid kernel release length'
for digest in "$abi" "$kernel_hash" "$initramfs_hash" "$package_hash" "$index_hash" "$bundle_hash"; do
    case $digest in ''|*[!0-9a-f]*) die 'Invalid kernel release checksum' ;; esac
    [ "${#digest}" = 64 ] || die 'Invalid kernel release checksum length'
done
case $package_version in [0-9]*) ;; *) die 'Invalid package version' ;; esac
case $package_version in *[!A-Za-z0-9._+-]*) die 'Invalid package version' ;; esac
[ "$(field package)" = reliefos-kernel ] &&
[ "$package_file" = "reliefos-kernel-$package_version.apk" ] &&
[ "$(field module_directory)" = "lib/modules/$release" ] || die 'Invalid package or module directory pairing'
hash_matches() {
    actual=$(sha256sum "$1") || return 1
    [ "${actual%% *}" = "$2" ]
}
# The immutable signed index is the only repository seen by the solver. A
# concurrent publication changing either remote file fails before root mutation.
mkdir "$temporary/download" "$temporary/verified" "$temporary/extracted"
rprfetch "$rpr_url/apk/packages.adb" "$temporary/download/packages.adb"
hash_matches "$temporary/download/packages.adb" "$index_hash" || die 'Repository checksum mismatch'
apk --keys-dir /etc/apk/keys verify "$temporary/download/packages.adb"
printf 'ndx %s/download/packages.adb\n' "$temporary" > "$temporary/repositories"
mkdir -p "$temporary/solver/etc/apk" "$temporary/solver/lib/apk/db"
printf 'x86_64\n' > "$temporary/solver/etc/apk/arch"
: > "$temporary/solver/etc/apk/world"
solver() {
    apk --root "$temporary/solver" --arch x86_64 --keys-dir /etc/apk/keys \
        --repositories-file "$temporary/repositories" --no-network "$@"
}
solver query --from repositories --match name --all-matches --fields package reliefos-kernel \
    > "$temporary/candidates" 2> "$temporary/query.errors" || {
    cat "$temporary/query.errors" >&2; die 'Cannot query the signed kernel candidate';
}
cat "$temporary/query.errors" >&2
[ ! -s "$temporary/query.errors" ] || die 'Cannot resolve the signed kernel candidate'
awk -v expected="Package: reliefos-kernel-$package_version" '
    /^$/ { next } $0 != expected || count++ { exit 1 } END { if (count != 1) exit 1 }
' "$temporary/candidates" || die 'Signed repository and advertised kernel package disagree'
local_package=$(apk --repositories-file /dev/null --no-network list --installed --manifest reliefos-kernel)
local_version=$(printf '%s\n' "$local_package" | awk 'NF==2 && $1=="reliefos-kernel" { print $2 }')
[ -n "$local_version" ] || die 'No managed kernel package; use the installer to migrate this system'
comparison=$(apk version --test "$local_version" "$package_version")
case $comparison in '<'|'='|'>') ;; *) die 'Cannot compare installed package versions' ;; esac
if [ "$force" = 0 ] && [ "$comparison" != '<' ]; then
    printf 'Kernel image is current: installed package=%s remote=%s (kernel %s)\n' "$local_version" "$package_version" "$release"
    exit 0
fi
printf 'Kernel image update available: installed package=%s remote=%s (kernel %s)\n' "$local_version" "$package_version" "$release"
[ "$check_only" = 0 ] || exit 0
# Boot resources are migrated by the installer, before any APK removes old
# files. Routine updates never replace firmware loaders or the stable selector.
[ -x "$helper" ] && [ ! -L "$helper" ] || die 'Missing native kernel bundle verifier'
[ -f /usr/lib/reliefos/kernel/current-release ] && [ ! -L /usr/lib/reliefos/kernel/current-release ] &&
[ -s /boot/grub/kernel-slots.cfg ] && [ ! -L /boot/grub/kernel-slots.cfg ] ||
    die 'Install the matched GRUB resources with the installer before updating this system'
[ ! -L /boot ] && [ ! -L /boot/reliefos ] || die 'Unsafe boot directory'
if mkdir /run/reliefos-kernel-update.lock 2>/dev/null; then lock_dir=/run/reliefos-kernel-update.lock
else die 'Another kernel update is already running'; fi
if mkdir /run/leonos-kernel-update.lock 2>/dev/null; then legacy_lock_dir=/run/leonos-kernel-update.lock
else die 'Another kernel update is already running'; fi
# Ask APK to solve an empty private database so every dependency comes from the
# frozen signed cohort. Query metadata first: fetch --url also requires local
# archives to exist when the index is local. Some query failures return zero,
# so also require a nonempty typed result without error diagnostics.
solver query --from repositories --recursive --fields package "reliefos-kernel=$package_version" \
    > "$temporary/solution" 2> "$temporary/solver.errors" || {
    cat "$temporary/solver.errors" >&2; die 'Cannot solve signed kernel dependencies';
}
cat "$temporary/solver.errors" >&2
[ ! -s "$temporary/solver.errors" ] || die 'Cannot resolve complete signed kernel dependencies'
awk '
    /^$/ { next }
    !/^Package: reliefos-[A-Za-z0-9._+-]+-[0-9][A-Za-z0-9._+-]*$/ { exit 1 }
    { name=substr($0,10); if (seen[name]++) exit 1; print name ".apk"; count++ }
    END { if (!count) exit 1 }
' "$temporary/solution" > "$temporary/packages" || die 'Invalid signed dependency solution'
while IFS= read -r name || [ -n "$name" ]; do
    [ ! -e "$temporary/download/$name" ] || die 'Duplicate signed dependency'
    rprfetch "$rpr_url/apk/$name" "$temporary/download/$name"
done < "$temporary/packages"
[ -f "$temporary/download/$package_file" ] || die 'Kernel package absent from solved dependency cohort'
hash_matches "$temporary/download/$package_file" "$package_hash" || die 'Kernel package checksum mismatch'
# A distinct empty output directory prevents APK fetch's existing-size shortcut
# from substituting for signed-index archive integrity validation.
solver fetch --recursive --output "$temporary/verified" "reliefos-kernel=$package_version"
while IFS= read -r name || [ -n "$name" ]; do
    [ -f "$temporary/verified/$name" ] || die 'A signed dependency was not completely verified by APK'
    apk --keys-dir /etc/apk/keys verify "$temporary/verified/$name"
done < "$temporary/packages"
[ -f "$temporary/verified/$package_file" ] || die 'Kernel archive was not verified by APK'
hash_matches "$temporary/verified/$package_file" "$package_hash" || die 'Verified kernel package checksum mismatch'
apk --keys-dir /etc/apk/keys extract --no-chown --destination "$temporary/extracted" "$temporary/verified/$package_file"
"$helper" --inspect "$temporary/extracted" "$release" > "$temporary/actual"
printf 'kernel_release=%s\nmodule_abi=%s\nkernel_sha256=%s\ninitramfs_sha256=%s\n' \
    "$release" "$abi" "$kernel_hash" "$initramfs_hash" > "$temporary/expected"
cmp -s "$temporary/expected" "$temporary/actual" || die 'Signed bundle and advertised boot identity disagree'
hash_matches "$temporary/extracted/usr/lib/reliefos/kernel/$release/bundle.json" "$bundle_hash" || die 'Signed bundle inventory checksum mismatch'
printf '%s\n' "$release" > "$temporary/expected-release"
cmp -s "$temporary/expected-release" "$temporary/extracted/usr/lib/reliefos/kernel/current-release" || die 'Signed current-release pointer mismatch'
cp "$temporary/download/packages.adb" "$temporary/verified/packages.adb"
printf 'ndx %s/verified/packages.adb\n' "$temporary" > "$temporary/repositories.verified"
# Plain world requests stay plain. No add of a local APK (checksum pin), exact
# world version, raw kernel rename, trust bypass or firmware rewrite occurs.
if [ "$force" = 1 ] && [ "$comparison" = '=' ]; then
    apk --repositories-file "$temporary/repositories.verified" --no-network fix --reinstall reliefos-kernel
else
    apk --repositories-file "$temporary/repositories.verified" --no-network upgrade reliefos-kernel
fi
"$helper" --inspect / "$release" > "$temporary/installed"
cmp -s "$temporary/expected" "$temporary/installed" || die 'Installed kernel bundle does not match the verified update'
printf 'Installed kernel %s (package %s); reboot to activate.\n' "$release" "$package_version"
