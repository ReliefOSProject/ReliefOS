#!/bin/sh
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

usage() { printf '%s\n' 'Usage: reliefos-kernel-update [-f|--force|--check]' >&2; }
check_only=0
force=0
case "${1-}" in
    '') ;;
    --check) check_only=1 ;;
    -f|--force) force=1 ;;
    *) usage; exit 2 ;;
esac
[ "$#" -le 1 ] || { usage; exit 2; }
if [ "$check_only" -eq 0 ] && [ "$(id -u)" -ne 0 ]; then
    printf '%s\n' 'reliefos-kernel-update: root privileges are required' >&2
    exit 1
fi

config=/etc/reliefos/rpr.conf
[ -r "$config" ] || { printf 'Missing RPR configuration: %s\n' "$config" >&2; exit 1; }
rpr_url=$(sed -n 's/^RPR_BASE_URL=//p' "$config")
case "$rpr_url" in https://*) ;; *) printf '%s\n' 'Invalid RPR URL: HTTPS is required' >&2; exit 1;; esac

manifest=$(mktemp /tmp/reliefos-kernel-release.XXXXXX) || exit 1
esp=/boot
boot=$esp/reliefos
legacy_boot=$esp/leonos
kernel_tmp=
kernel_backup=
lock_dir=
legacy_lock_dir=
boot_dir_created=0
had_kernel=0
commit_started=0
commit_done=0
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ "$commit_started" -eq 1 ] && [ "$commit_done" -eq 0 ]; then
        # GRUB boots kernel.sys directly, so the on-disk kernel is the single
        # release unit and a failed commit restores exactly what was there.
        if [ -n "$kernel_backup" ] && [ -f "$kernel_backup" ]; then
            rm -f -- "$boot/kernel.sys"
            mv -- "$kernel_backup" "$boot/kernel.sys" || true
        elif [ "$had_kernel" -eq 0 ]; then
            rm -f -- "$boot/kernel.sys"
        fi
        sync || true
    fi
    rm -f -- "$manifest"
    [ -z "$kernel_tmp" ] || rm -f -- "$kernel_tmp" "$kernel_tmp.part"
    if [ "$commit_done" -eq 1 ]; then
        [ -z "$kernel_backup" ] || rm -f -- "$kernel_backup"
    fi
    [ -z "$lock_dir" ] || rmdir -- "$lock_dir" 2>/dev/null || true
    [ -z "$legacy_lock_dir" ] || rmdir -- "$legacy_lock_dir" 2>/dev/null || true
    if [ "$boot_dir_created" -eq 1 ]; then
        rmdir -- "$boot" 2>/dev/null || true
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM
rprfetch "$rpr_url/kernel/release.txt" "$manifest" || exit 1

field() {
    key=$1
    value=$(sed -n "s/^${key}=//p" "$manifest")
    [ -n "$value" ] || return 1
    case "$value" in
        *'
'*) return 1 ;;
    esac
    printf '%s' "$value"
}
format=$(field format_version) || { printf '%s\n' 'Invalid kernel release manifest' >&2; exit 1; }
remote_image=$(field image_version) || remote_image=
remote_release=$(field version) || { printf '%s\n' 'Kernel release has no version' >&2; exit 1; }
kernel_file=$(field kernel_file) || exit 1
kernel_hash=$(field kernel_sha256) || exit 1
[ "$format" = 3 ] || {
    printf 'Unsupported kernel release manifest: %s (format 1 advertised a middle-layer payload; format 2 paired kernel.sys with loader.elf)\n' "$format" >&2
    exit 1;
}
printf '%s\n' "$remote_release" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || {
    printf 'Invalid remote release version: %s\n' "$remote_release" >&2; exit 1;
}
release_image=$remote_release
[ -n "$remote_image" ] || remote_image=$release_image
case "$remote_image" in *[!0-9.]*|''|.*|*.) printf 'Invalid remote image version: %s\n' "$remote_image" >&2; exit 1;; esac
[ "$release_image" = "$remote_image" ] || {
    printf '%s\n' 'Remote image and release versions disagree' >&2
    exit 1
}
case "$kernel_file" in kernel.sys) ;; *) printf '%s\n' 'Invalid kernel release filename' >&2; exit 1;; esac
case "$kernel_hash" in *[!0-9a-f]*|'') printf '%s\n' 'Invalid kernel.sys checksum' >&2; exit 1;; esac
[ "${#kernel_hash}" -eq 64 ] || {
    printf '%s\n' 'Invalid kernel release checksum length' >&2
    exit 1
}

local_release=$(uname -r) || exit 1
local_image=${local_release%%-*}
version_is_newer() {
    awk -v local_version="$1" -v remote_version="$2" 'BEGIN {
        nl=split(local_version, l, /\./); nr=split(remote_version, r, /\./)
        if (nl != 3 || nr != 3) exit 2
        for (i=1; i<=3; i++) {
            if (l[i] !~ /^[0-9]+$/ || r[i] !~ /^[0-9]+$/) exit 2
            if ((r[i]+0) > (l[i]+0)) exit 0
            if ((r[i]+0) < (l[i]+0)) exit 1
        }
        exit 1
    }'
}
version_is_newer "$local_image" "$remote_image"
comparison=$?
[ "$comparison" -ne 2 ] || { printf 'Invalid local image version: %s\n' "$local_image" >&2; exit 1; }
if [ "$force" -eq 0 ] && [ "$comparison" -ne 0 ]; then
    printf 'Kernel image is current: local=%s remote=%s (releases %s / %s)\n' \
        "$local_image" "$remote_image" "$local_release" "$remote_release"
    exit 0
fi
if [ "$force" -eq 1 ]; then
    printf 'Forcing kernel image update: local=%s remote=%s (remote build %s)\n' \
        "$local_image" "$remote_image" "$remote_release"
else
    printf 'Kernel image update available: local=%s remote=%s (remote build %s)\n' \
        "$local_image" "$remote_image" "$remote_release"
fi
[ "$check_only" -eq 0 ] || exit 0

if [ -L "$boot" ] || { [ -e "$boot" ] && [ ! -d "$boot" ]; }; then
    printf 'Unsafe canonical boot directory: %s\n' "$boot" >&2
    exit 1
fi
if { [ ! -f "$boot/kernel.sys" ]; } &&
    { [ ! -d "$legacy_boot" ] || [ ! -f "$legacy_boot/kernel.sys" ]; }; then
    printf 'Boot payload is unavailable under %s and %s\n' "$boot" "$legacy_boot" >&2
    exit 1
fi
if [ ! -d "$boot" ]; then
    mkdir -- "$boot" || { printf 'Cannot create canonical boot directory: %s\n' "$boot" >&2; exit 1; }
    boot_dir_created=1
fi
lock_dir=/run/reliefos-kernel-update.lock
mkdir -- "$lock_dir" 2>/dev/null || {
    printf '%s\n' 'Another kernel update is already running' >&2
    lock_dir=
    exit 1
}
legacy_lock_dir=/run/leonos-kernel-update.lock
mkdir -- "$legacy_lock_dir" 2>/dev/null || {
    printf '%s\n' 'Another kernel update is already running' >&2
    rmdir -- "$lock_dir" 2>/dev/null || true
    lock_dir=
    legacy_lock_dir=
    exit 1
}
# Each download lands on the filesystem that owns the file it replaces, so the
# commit step renames within one filesystem instead of copying across devices.
kernel_tmp=$(mktemp "$boot/.kernel.sys.rpr.XXXXXX") || exit 1
rprfetch "$rpr_url/kernel/$kernel_file" "$kernel_tmp" || exit 1
actual_kernel=$(sha256sum "$kernel_tmp" | awk '{print $1}')
[ "$actual_kernel" = "$kernel_hash" ] || { printf '%s\n' 'kernel.sys checksum mismatch' >&2; exit 1; }
chmod 0644 "$kernel_tmp" || exit 1

kernel_backup="$boot/.kernel.sys.rpr-backup.$$"
[ ! -e "$kernel_backup" ] || {
    printf '%s\n' 'Kernel update backup path already exists' >&2
    exit 1
}
commit_started=1
if [ -e "$boot/kernel.sys" ]; then
    mv -- "$boot/kernel.sys" "$kernel_backup" || exit 1
    had_kernel=1
fi
mv -- "$kernel_tmp" "$boot/kernel.sys" || exit 1
kernel_tmp=
sync || exit 1
commit_done=1
printf 'Installed kernel %s (build %s); reboot to activate.\n' \
    "$remote_image" "$remote_release"
exit 0
