#!/bin/sh
# Signed offline package transactions for the installer. Inspection uses a
# private database and accepts a read-only installed root.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
umask 077

die() { printf 'update: %s\n' "$*" >&2; exit 1; }
mode=apply
expected_index=
case "$#:${1:-}" in
    2:*) target=$1; repository=$2 ;;
    3:--check|3:--apply|4:--apply)
        mode=${1#--}; target=$2; repository=$3; expected_index=${4:-} ;;
    *) echo 'usage: reliefos-apk-update [--check|--apply] TARGET_ROOT SIGNED_REPOSITORY [INDEX_SHA256]' >&2; exit 2 ;;
esac
case "$target:$repository" in /*:/*) ;; *) die 'absolute target and repository paths are required' ;; esac
[ ! -L "$target" ] && [ ! -L "$repository" ] || die 'target and repository must be real directories'
target=$(CDPATH= cd -- "$target" && pwd -P)
repository=$(CDPATH= cd -- "$repository" && pwd -P)
[ "$target" != / ] || die 'boot the installation media to update an offline system'
for file in "$target/etc/apk/world" "$target/lib/apk/db/installed" "$repository/packages.adb"; do
    [ -s "$file" ] && [ ! -L "$file" ] || die "missing or unsafe package metadata: $file"
done
[ -d "$target/etc/apk/keys" ] && [ ! -L "$target/etc/apk/keys" ] || die 'installed package trust keys are missing'
index_sha=$(/bin/busybox sha256sum "$repository/packages.adb")
index_sha=${index_sha%% *}
[ -z "$expected_index" ] || [ "$index_sha" = "$expected_index" ] || die 'installation media changed after inspection; check the update again'

temporary=$(/bin/busybox mktemp -d /tmp/reliefos-update.XXXXXX)
world_changed=0
retention_started=0
activation_deferred=0
kernel_bundle=${RELIEFOS_KERNEL_BUNDLE_HELPER:-/usr/libexec/reliefos/kernel-bundle}
activation_marker=$target/run/reliefos-kernel-activation.defer
cleanup() {
    result=$?
    trap - EXIT HUP INT TERM
    set +e
    if [ "$retention_started" -eq 1 ]; then
        "$kernel_bundle" --restore-all "$target" || result=1
    fi
    # Only roll world back when APK did not modify its database. A partially
    # committed database must keep APK's actual world for a consistent retry.
    if [ "$result" -ne 0 ] && [ "$world_changed" -eq 1 ] &&
       /bin/busybox cmp -s "$temporary/installed-before" "$target/lib/apk/db/installed"; then
        if /bin/busybox cp -p "$temporary/world-before" "$target/etc/apk/world.restore.$$" &&
           /bin/busybox mv "$target/etc/apk/world.restore.$$" "$target/etc/apk/world"; then :
        else result=1
        fi
    fi
    if [ "$activation_deferred" -eq 1 ]; then
        /bin/busybox rm -f "$activation_marker" || result=1
    fi
    /bin/busybox rm -rf "$temporary"
    exit "$result"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

plan=$temporary/root
/bin/busybox mkdir -p "$plan/etc/apk" "$plan/lib/apk/db" "$plan/var/cache/apk" "$temporary/repository"
/bin/busybox cp "$target/lib/apk/db/installed" "$plan/lib/apk/db/installed"
/bin/busybox cp "$target/lib/apk/db/installed" "$temporary/installed-before"
/bin/busybox cp -p "$target/etc/apk/world" "$temporary/world-before"
# Retired ReliefOS command wrappers map to their official packages; the old
# Dillo request maps to NetSurf and its split common-data request is dropped.
# Local generation/version constraints cannot describe upstream versions. Keep
# existing upstream requests (including their tags/pins) and unrelated world
# entries, using an inherited tag only when adding a missing request.
# Editing the private plan lets APK remove the old owners in the same signed
# transaction that installs their replacements; --check never edits the target.
: > "$temporary/upstream-packages"
/bin/busybox awk -v upstream_packages="$temporary/upstream-packages" '
    function canonical(request) {
        sub(/^leonos-/, "reliefos-", request)
        return request
    }
    function package_name(request) {
        sub(/[@<>=~].*$/, "", request)
        return request
    }
    function emit(request) {
        if (!seen[request]++) print request
    }
    function upstream(name, tag) {
        if (!(name in present)) emit(name tag)
        print name >> upstream_packages
    }
    NR == FNR { present[package_name(canonical($0))] = 1; next }
    {
        request = canonical($0)
        name = package_name(request)
        tag = ""
        if (index(request, "@")) {
            tag = request
            sub(/^[^@]*@/, "", tag)
            sub(/[<>=~].*$/, "", tag)
            tag = "@" tag
        }
        if (name == "dillo") { upstream("netsurf", tag); next }
        if (name == "dillo-common") next
        if (name !~ /^reliefos-(sl|ncurses|sqlite)$/) { emit(request); next }
        if (name == "reliefos-sl") upstream("sl", tag)
        if (name == "reliefos-ncurses") {
            upstream("ncurses", tag)
            upstream("ncurses-terminfo", tag)
        }
        if (name == "reliefos-sqlite") {
            upstream("sqlite", tag)
            upstream("sqlite-libs", tag)
        }
    }
' "$temporary/world-before" "$temporary/world-before" > "$plan/etc/apk/world"
if [ -f "$target/etc/apk/arch" ]; then
    [ ! -L "$target/etc/apk/arch" ] || die 'unsafe installed architecture file'
    /bin/busybox cp "$target/etc/apk/arch" "$plan/etc/apk/arch"
fi

# APK requires each world tag to have an available repository even when its
# packages are already installed. Register those tags against the same signed
# offline media for this transaction only. Installed packages still satisfy
# world/dependency constraints; new archives can only come from the media.
# Do not depend on online repositories or their possibly absent/stale caches,
# and never strip tags from the installed world or rewrite repository settings.
: > "$temporary/tags"
while IFS= read -r dependency || [ -n "$dependency" ]; do
    case "$dependency" in
        *@*)
            tag=${dependency#*@}; tag=${tag%%[\<\>\=\~]*}
            case "$tag" in ''|*[!a-zA-Z0-9_.+-]*) die 'invalid repository tag in installed world' ;; esac
            printf '%s\n' "$tag" >> "$temporary/tags"
            ;;
    esac
done < "$plan/etc/apk/world"
/bin/busybox sort -u "$temporary/tags" > "$temporary/required-tags"
write_repositories() {
    source_repository=$1
    tag_repositories=$2
    printf 'ndx %s/packages.adb\n' "$source_repository"
    number=0
    while IFS= read -r tag; do
        number=$((number + 1))
        tagged_repository=$tag_repositories/$number
        /bin/busybox mkdir -p "$tagged_repository"
        /bin/busybox cp "$source_repository/packages.adb" "$tagged_repository/packages.adb"
        for archive in "$source_repository"/*.apk; do
            [ -f "$archive" ] || continue
            /bin/busybox ln -s "$archive" "$tagged_repository/${archive##*/}"
        done
        # Distinct index URLs keep APK's default/tagged repository masks
        # separate, preserving the installed origin tag of retained extras.
        printf 'ndx @%s %s/packages.adb\n' "$tag" "$tagged_repository"
    done < "$temporary/required-tags"
}
configuration=$temporary/repositories
write_repositories "$repository" "$temporary/tagged-media" > "$configuration"

broken_packages() {
    /bin/busybox awk -v exclude_system="$2" '
        function emit() {
            if (flags ~ /[fs]/ && (!exclude_system || name !~ /^(leonos|reliefos)-/))
                print name "\t" version "\t" checksum "\t" flags
            name = version = checksum = flags = ""
        }
        /^P:/ { name = substr($0, 3) }
        /^V:/ { version = substr($0, 3) }
        /^C:/ { checksum = substr($0, 3) }
        /^f:/ { flags = substr($0, 3) }
        /^$/ { emit() }
        END { emit() }
    ' "$1/lib/apk/db/installed" | /bin/busybox sort
}

# Preserve APK's exact exit status while streaming its output through tee.
# The status file is written before the pipeline closes, including on errors.
run_transaction() {
    run_root=$1
    run_log=$2
    operation=$3
    shift 3
    exclude_system=1
    [ "$#" -eq 0 ] || exclude_system=0
    broken_packages "$run_root" "$exclude_system" > "$temporary/broken-before"
    (
        set +e
        if [ "$operation" = fix ]; then
            apk --root "$run_root" --keys-dir "$target/etc/apk/keys" \
                --repositories-file "$configuration" --no-network "$@" fix --reinstall --upgrade $repair_packages
        else
            apk --root "$run_root" --keys-dir "$target/etc/apk/keys" \
                --repositories-file "$configuration" --no-network "$@" upgrade $packages
        fi
        printf '%s\n' "$?" > "$temporary/apk-status"
    ) 2>&1 | /bin/busybox tee "$run_log"
    status=$(/bin/busybox cat "$temporary/apk-status")
    [ "$status" -ne 0 ] || return 0
    broken_packages "$run_root" 0 > "$temporary/broken-after"
    count=$(/bin/busybox awk 'END { print NR }' "$temporary/broken-before")
    if [ "$count" -gt 0 ] && [ "$count" -lt 125 ] && [ "$status" -eq "$count" ] &&
       /bin/busybox cmp -s "$temporary/broken-before" "$temporary/broken-after" &&
       ! /bin/busybox grep -q '^ERROR:' "$run_log" &&
       /bin/busybox tail -n 1 "$run_log" |
           /bin/busybox grep -Eq "^$status errors?; .+ in [0-9]+ packages$"; then
        echo 'WARNING: pre-existing external package errors remain:' >&2
        /bin/busybox cut -f 1 "$temporary/broken-before" >&2
        return 0
    fi
    return "$status"
}

echo 'Checking signed repository and package archives'
packages=$(apk --root "$plan" --keys-dir "$target/etc/apk/keys" \
    --repositories-file "$configuration" --no-network search --quiet 'reliefos-*')
[ -n "$packages" ] || die 'the signed repository has no ReliefOS packages'
for name in $packages; do
    case "$name" in reliefos-*) ;; *) die 'invalid system package name' ;; esac
    case "$name" in *[!a-zA-Z0-9+_.-]*) die 'invalid system package name' ;; esac
done
repair_packages=$(broken_packages "$plan" 0 | /bin/busybox awk -F '\t' \
    '$1 ~ /^reliefos-/ && $1 !~ /^reliefos-(sl|ncurses|sqlite)$/ { print $1 }')
for name in $repair_packages; do
    case "$name" in *[!a-zA-Z0-9+_.-]*) die 'invalid repair package name' ;; esac
done
# Replacement commands are world selections, no longer dependencies of local
# wrappers. Include them in the verified archive set before the solver runs.
upstream_packages=$(/bin/busybox sort -u "$temporary/upstream-packages")
apk --root "$plan" --keys-dir "$target/etc/apk/keys" \
    --repositories-file "$configuration" --no-network fetch --recursive \
    --output "$temporary/repository" $packages $repair_packages $upstream_packages
apk --root "$plan" --keys-dir "$target/etc/apk/keys" --no-network \
    verify "$temporary/repository/"*.apk
/bin/busybox cp "$repository/packages.adb" "$temporary/repository/packages.adb"
write_repositories "$temporary/repository" "$temporary/tagged-verified" > "$temporary/verified.repositories"
configuration=$temporary/verified.repositories
echo 'Calculating the offline package transaction'
if [ -n "$repair_packages" ]; then
    run_transaction "$plan" "$temporary/repair-plan.log" fix --simulate
fi
run_transaction "$plan" "$temporary/plan.log" upgrade --simulate
printf 'RELIEFOS_UPDATE_INDEX_SHA256=%s\n' "$index_sha"
[ "$mode" != check ] || exit 0

echo 'Preserving installed kernel modules and local configuration'
case "$kernel_bundle" in /*) ;; *) die 'kernel retention helper must have an absolute path' ;; esac
[ -x "$kernel_bundle" ] || die 'native kernel retention helper is missing'
/bin/sh /usr/lib/reliefos/reliefos-migrate "$target"
"$kernel_bundle" --retain-installed "$target"
retention_started=1
[ ! -L "$target/run" ] && { [ ! -e "$target/run" ] || [ -d "$target/run" ]; } || die 'unsafe target run directory'
/bin/busybox mkdir -p "$target/run"
[ ! -e "$activation_marker" ] && [ ! -L "$activation_marker" ] || die 'kernel activation is already pending'
(set -C; printf '%s\n' 'ReliefOS installer package transaction' > "$activation_marker")
activation_deferred=1

# A concurrent administrator edit must be inspected again before committing.
/bin/busybox cmp -s "$temporary/world-before" "$target/etc/apk/world" || die 'installed package selection changed during preflight'
/bin/busybox cmp -s "$temporary/installed-before" "$target/lib/apk/db/installed" || die 'installed package database changed during preflight'
/bin/busybox cp -p "$temporary/world-before" "$target/etc/apk/world.reliefos-update.$$"
/bin/busybox cat "$plan/etc/apk/world" > "$target/etc/apk/world.reliefos-update.$$"
/bin/busybox mv "$target/etc/apk/world.reliefos-update.$$" "$target/etc/apk/world"
world_changed=1
echo 'Applying the signed package transaction'
if [ -n "$repair_packages" ]; then
    run_transaction "$target" "$temporary/repair.log" fix
fi
run_transaction "$target" "$temporary/transaction.log" upgrade
/bin/busybox chroot "$target" /bin/sh /usr/lib/reliefos/migrate-shell

echo 'Publishing the verified offline repository'
for relative in usr usr/share usr/share/reliefos usr/share/reliefos/apk usr/share/reliefos/apk/repository; do
    path=$target/$relative
    [ ! -L "$path" ] && { [ ! -e "$path" ] || [ -d "$path" ]; } || die "unsafe repository directory: $path"
    [ -d "$path" ] || /bin/busybox mkdir -m 0755 "$path"
done
destination=$target/usr/share/reliefos/apk/repository
for package in "$temporary/repository"/*.apk; do
    name=${package##*/}
    /bin/busybox cp "$package" "$destination/$name.new"
    /bin/busybox chmod 0644 "$destination/$name.new"
    /bin/busybox mv "$destination/$name.new" "$destination/$name"
done
/bin/busybox cp "$temporary/repository/packages.adb" "$destination/packages.adb.new"
/bin/busybox chmod 0644 "$destination/packages.adb.new"
/bin/busybox mv "$destination/packages.adb.new" "$destination/packages.adb"
# Old offline archives must not keep the removed wrappers installable. Limit
# cleanup to these retired package names; retain unrelated administrator files.
for component in sl ncurses sqlite; do
    for prefix in reliefos leonos; do
        for archive in "$destination/$prefix-$component-"[0-9]*.apk; do
            [ -e "$archive" ] || [ -L "$archive" ] || continue
            [ -f "$archive" ] && [ ! -L "$archive" ] || die "unsafe retired package archive: $archive"
            /bin/busybox rm "$archive"
        done
    done
done
/bin/busybox sync
