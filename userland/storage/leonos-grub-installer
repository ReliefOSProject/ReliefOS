#!/bin/sh
# Compatibility spelling for the shared UEFI-only boot publisher.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
source=/install/esp
if [ "${1-}" = --source ]; then
    [ "$#" -ge 3 ] || { printf '%s\n' 'Usage: reliefos-grub-installer [--source DIR] ESP-MOUNTPOINT' >&2; exit 2; }
    source=$2
    shift 2
fi
[ "$#" -eq 1 ] && [ -d "$1" ] || {
    printf '%s\n' 'Usage: reliefos-grub-installer [--source DIR] ESP-MOUNTPOINT' >&2
    exit 2
}
exec /usr/sbin/reliefos-boot-install --source "$source" --boot-directory "$1" \
    --bios=no --uefi=yes --update
