#!/bin/sh
# The installer runs this from its own root, against the mounted target.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
if [ "$#" -ne 2 ]; then
    echo "usage: reliefos-apk-update TARGET_ROOT SIGNED_REPOSITORY" >&2
    exit 2
fi
target=$1
repository=$2
case "$target:$repository" in
    /*:/*) ;;
    *) echo "target and repository must be absolute paths" >&2; exit 2 ;;
esac
if [ ! -s "$target/lib/apk/db/installed" ]; then
    echo "Target has no APK database; reinstall from APK-enabled media." >&2
    exit 1
fi
if [ ! -f "$repository/packages.adb" ]; then
    echo "Missing signed ReliefOS repository index." >&2
    exit 1
fi
# Retain only repository tags used by world, plus the signed update source.
# Unused network repositories must not make a fresh system's offline update fail.
temporary=/tmp/reliefos-apk-update.$$
(umask 077; /bin/busybox mkdir "$temporary")
restore_world=0
cleanup() {
    if [ "$restore_world" -eq 1 ]; then
        /bin/busybox cp "$temporary/world-before" "$target/etc/apk/world.restore.$$"
        /bin/busybox mv "$target/etc/apk/world.restore.$$" "$target/etc/apk/world"
    fi
    /bin/busybox rm -rf "$temporary"
}
trap cleanup EXIT HUP INT TERM
( /bin/busybox mkdir "$temporary/seen" )
required_tags=' '
while IFS= read -r dependency || [ -n "$dependency" ]; do
    case "$dependency" in
        *@*) tag=${dependency#*@}; tag=${tag%%[\<\>\=\~]*}; required_tags="$required_tags$tag " ;;
    esac
done < "$target/etc/apk/world"
configuration=$temporary/repositories
printf 'ndx %s/packages.adb\n' "$repository" > "$configuration"
append_repositories() {
    [ -f "$1" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        read -r first second third rest <<EOF
$line
EOF
        case "$first" in
            set) printf '%s\n' "$line" >> "$configuration"; continue ;;
            @*) kind=; tag=$first; url=$second; components="$third $rest" ;;
            v2|v3|ndx) kind=$first; tag=$second; url=$third; components=$rest ;;
            *) continue ;;
        esac
        case "$tag" in @*) ;; *) continue ;; esac
        case "$required_tags" in *" ${tag#@} "*) ;; *) continue ;; esac
        # Local paths in the target's configuration are in its namespace.
        case "$url" in
            /*) url=$target$url ;;
            file:///*) url=$target${url#file://} ;;
        esac
        printf '%s %s %s %s\n' "$kind" "$tag" "$url" "$components" >> "$configuration"
    done < "$1"
}
append_repositories "$target/etc/apk/repositories"
for directory in "$target/etc/apk/repositories.d" "$target/lib/apk/repositories.d"; do
    for snippet in "$directory"/*.list; do
        [ -f "$snippet" ] || continue
        name=${snippet##*/}
        [ ! -e "$temporary/seen/$name" ] || continue
        : > "$temporary/seen/$name"
        append_repositories "$snippet"
    done
done
# Target trust anchors and cached signed indexes remain authoritative. Missing
# metadata for an in-use tag is an error, never a reason to rewrite world.
# apk 3 counts unchanged broken packages in the transaction's exit status.
# Parse installed-db records (P/V/C/f), retaining identity and the exact flags;
# uppercase S is a digest-format flag, not a broken script (lowercase s).
broken_packages() {
    /bin/busybox awk -v exclude_system="$1" '
        function emit() {
            if (flags ~ /[fs]/ && (!exclude_system || name !~ /^(leonos|reliefos)-/))
                print name "\t" version "\t" checksum "\t" flags
            name = version = checksum = flags = ""
        }
        /^P:/ { name = substr($0, 3) }
        /^V:/ { version = substr($0, 3) }
        /^C:/ { checksum = substr($0, 3) }
        /^f:/ { flags = substr($0, 3) }
        /^$/ { emit() }
        END { emit() }
    ' "$target/lib/apk/db/installed" > "$temporary/records"
    /bin/busybox sort "$temporary/records"
}
# Download and validate every ReliefOS package before changing world or letting
# apk remove any legacy package. The signed index binds each archive's digest.
preflight_repository=$temporary/preflight
/bin/busybox mkdir "$preflight_repository"
status=0
apk --root "$target" --repositories-file "$configuration" --no-network fetch --recursive \
    --output "$preflight_repository" 'reliefos-*' > "$temporary/preflight.log" 2>&1 || status=$?
/bin/busybox cat "$temporary/preflight.log"
if [ "$status" -ne 0 ]; then
    exit "$status"
fi
/bin/busybox cp "$repository/packages.adb" "$preflight_repository/packages.adb"
preflight_configuration=$temporary/repositories.preflight
/bin/busybox awk -v repo_index="$preflight_repository/packages.adb" \
    'NR == 1 { print "ndx " repo_index; next } { print }' \
    "$configuration" > "$preflight_configuration"
configuration=$preflight_configuration
# Copy known old-brand configuration before apk introduces canonical defaults.
# The migrator never overwrites an existing canonical file and verifies bytes,
# mode and ownership before publishing; a failure prevents the transaction.
/bin/sh /usr/lib/reliefos/reliefos-migrate "$target"
broken_packages 1 > "$temporary/broken-before"
world=$target/etc/apk/world
/bin/busybox cp "$world" "$temporary/world-before"
sed 's/^leonos-/reliefos-/' "$temporary/world-before" > "$temporary/world-after"
# Move the desired package names first so apk's own solver removes each old
# package through the replacement metadata in the signed ReliefOS index.
/bin/busybox cp "$temporary/world-after" "$target/etc/apk/world.reliefos-update.$$"
/bin/busybox mv "$target/etc/apk/world.reliefos-update.$$" "$world"
restore_world=1
status=0
apk --root "$target" --repositories-file "$configuration" --no-network upgrade 'reliefos-*' \
    > "$temporary/transaction.log" 2>&1 || status=$?
/bin/busybox cat "$temporary/transaction.log"
if [ "$status" -ne 0 ]; then
    broken_packages 0 > "$temporary/broken-after"
    count=$(/bin/busybox awk 'END { print NR }' "$temporary/broken-before")
    # Require a completed commit, no new diagnostics, unchanged external
    # broken records/world, and exactly their known error contribution.
    # Solver, trust, extraction, script and database-write failures remain fatal.
    if [ "$count" -gt 0 ] && [ "$count" -lt 125 ] && [ "$status" -eq "$count" ] &&
       /bin/busybox cmp -s "$temporary/broken-before" "$temporary/broken-after" &&
       /bin/busybox cmp -s "$temporary/world-after" "$target/etc/apk/world" &&
       ! /bin/busybox grep -q '^ERROR:' "$temporary/transaction.log" &&
       /bin/busybox tail -n 1 "$temporary/transaction.log" |
           /bin/busybox grep -Eq "^$status errors?; .+ in [0-9]+ packages$"; then
        echo "WARNING: ReliefOS packages updated; pre-existing external package errors remain:" >&2
        /bin/busybox cut -f 1 "$temporary/broken-before" >&2
    else
        exit "$status"
    fi
fi
restore_world=0
/bin/busybox chroot "$target" /bin/sh /usr/lib/reliefos/migrate-shell
# Publish the offline repository only after the package transaction succeeded.
destination=$target/usr/share/reliefos/apk/repository
/bin/busybox mkdir -p "$destination"
for package in "$repository"/*.apk; do
    /bin/busybox cp "$package" "$destination/$(/bin/busybox basename "$package").new"
    /bin/busybox mv "$destination/$(/bin/busybox basename "$package").new" "$destination/$(/bin/busybox basename "$package")"
done
/bin/busybox cp "$repository/packages.adb" "$destination/packages.adb.new"
/bin/busybox mv "$destination/packages.adb.new" "$destination/packages.adb"
/bin/busybox sync
