[Desktop Entry]
Type=Application
Name=ReliefPlayer
GenericName=Media Player
GenericName[zh_CN]=媒体播放器
Comment=Play local MP3 and WAV audio and MP4 video
Comment[zh_CN]=播放本地 MP3、WAV 音频和 MP4 视频
Exec=/usr/bin/reliefplayer %f
TryExec=/usr/bin/reliefplayer
Icon=reliefos-reliefplayer
Terminal=false
Categories=AudioVideo;Audio;Video;Player;
MimeType=audio/mpeg;audio/x-wav;audio/wav;audio/vnd.wave;video/mp4;
StartupWMClass=reliefos-reliefplayer
