$(addprefix $(obj)/,$(RELIEFOS_ZLIB_ASM_OBJECTS)): $(AUTOCONF_H) $(HEADER_EXPORT_MANIFEST) $(RELIEFOS_CC_ID)

ccflags-y += -DZ_SOLO -include stddef.h
$(obj)/adler32.o: $(srctree)/third_party/zlib/adler32.c FORCE
	$(call if_changed_dep,cc_o_c)
