#!/sbin/openrc-run
description="Ethernet configuration and BusyBox DHCP clients"
depend() { need reliefos-runtime reliefos-modules; provide net; }

start() {
    local iface started interfaces
    started=""
    interfaces=$(/usr/lib/reliefos/network-profile list) || return 1
    for iface in $interfaces; do
        if ! /usr/lib/reliefos/network-profile start "$iface"; then
            /usr/lib/reliefos/network-profile stop "$iface" || :
            for iface in $started; do
                /usr/lib/reliefos/network-profile stop "$iface" || :
            done
            return 1
        fi
        started="$started $iface"
    done
}

stop() {
    local iface result interfaces
    result=0
    interfaces=$(/usr/lib/reliefos/network-profile list) || return 1
    for iface in $interfaces; do
        /usr/lib/reliefos/network-profile stop "$iface" || result=1
    done
    return "$result"
}
