#!/sbin/openrc-run
description="BusyBox DHCP client"
supervisor=supervise-daemon
retry=TERM/1/KILL/1
input_file=/dev/null
command=/sbin/udhcpc
command_args="-f -R -i eth0 -s /usr/share/udhcpc/default.script -t 3 -T 1 -A 30"
respawn_delay=5
respawn_max=3
respawn_period=60
output_log=/var/log/udhcpc.log
error_log=/var/log/udhcpc.log
depend() { need reliefos-runtime reliefos-modules; provide net; }

start_pre() {
    rm -f /run/reliefos/dhcp-lease || return 1
    /sbin/ifconfig eth0 up
}
