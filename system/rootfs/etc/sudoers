Defaults env_reset
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Defaults use_pty
Defaults timestamp_timeout=5
Defaults logfile="/var/log/sudo.log"
Defaults!/usr/lib/reliefos/apps/sudod/sudod.elf !use_pty
# The API installation worker returns binary progress records over stdout.
Defaults!/usr/lib/reliefos/apps/apiapp/apiapp.elf !use_pty
# OpenRC Controller uses a framed stdin/stdout session after authentication.
# Keep EOF and binary framing intact; this grants no additional sudo rights.
Defaults!/usr/lib/reliefos/apps/openrc-controller/openrc-controller.elf !use_pty
root ALL=(ALL:ALL) ALL
# The installer adds its initial user to wheel; sudo authenticates that user.
%wheel ALL=(ALL:ALL) ALL
@includedir /etc/sudoers.d
