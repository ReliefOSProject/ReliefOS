#!/bin/sh
# Each BusyBox client owns only its interface's address, route and cache.
set -eu
interface=${interface:-}
test -n "$interface" || exit 1
# This also verifies that the validated name is an enumerated Ethernet device.
/usr/lib/reliefos/network-profile interface "$interface"
case "$interface" in
    eth0) dns_file=/run/reliefos/dhcp-dns; lease_file=/run/reliefos/dhcp-lease ;;
    *) dns_file=/run/reliefos/dhcp-dns.$interface; lease_file=/run/reliefos/dhcp-lease.$interface ;;
esac
case "${1:-}" in
    bound|renew)
        /sbin/ifconfig "$interface" "$ip" netmask "$subnet" ${broadcast:+broadcast "$broadcast"} up
        /sbin/route del default dev "$interface" 2>/dev/null || :
        for gateway in ${router:-}; do /sbin/route add default gw "$gateway" dev "$interface"; break; done
        tmp=$(mktemp /run/reliefos/.dhcp-dns.XXXXXX)
        printf '%s\n' "${dns:-}" > "$tmp"
        mv -f "$tmp" "$dns_file"
        /usr/lib/reliefos/publish-resolver
        read -r uptime rest < /proc/uptime
        acquired=${uptime%%.*}
        lease_tmp=$(mktemp /run/reliefos/.dhcp-lease.XXXXXX)
        trap 'rm -f "$lease_tmp"' EXIT HUP INT TERM
        printf 'ip=%s\nsubnet=%s\nrouter=%s\ndns=%s\nlease=%s\nacquired=%s\n' "$ip" "$subnet" "${router:-}" "${dns:-}" "${lease:-}" "$acquired" > "$lease_tmp"
        chmod 0644 "$lease_tmp"
        mv -f "$lease_tmp" "$lease_file"
        trap - EXIT HUP INT TERM
        ;;
    deconfig)
        /sbin/ifconfig "$interface" 0.0.0.0
        rm -f "$dns_file" "$lease_file"
        /usr/lib/reliefos/publish-resolver
        ;;
    leasefail|nak) echo "DHCP $1 on $interface" >&2; exit 1 ;;
    *) exit 2 ;;
esac
