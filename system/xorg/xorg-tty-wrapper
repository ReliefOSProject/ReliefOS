#!/bin/sh
# Run Xorg with tty1 attached to all standard descriptors.
#
# xdm keeps the server in the foreground but does not guarantee that its
# server child inherits the console descriptors.  Xorg's Linux VT backend
# uses its standard console descriptor when it enters VT_PROCESS/KD_GRAPHICS.
# Keep this process in xdm's session; Xorg can then perform its normal
# console setup without a second launcher session competing for tty1.
set -eu

tty=/dev/tty1
if test ! -r "$tty" || test ! -w "$tty"; then
    printf '%s\n' "xorg-tty-wrapper: cannot access $tty" >&2
    exit 1
fi

exec <"$tty" >"$tty" 2>&1
if test ! -c /dev/dri/card0 && test -c /dev/fb0; then
    /usr/sbin/fbset -fb /dev/fb0 -depth 32 || :
fi
# Hardware cursors let SVGA and VirtIO move the pointer without damaging the
# scanout. VirtIO also enables fenced page flips. An explicitly selected
# administrator configuration wins.
explicit_config=false
for argument do
    case "$argument" in -config|-configdir) explicit_config=true ;; esac
done
backend= pageflip=
pci=/sys/class/drm/card0/device
if test "$explicit_config" = false && test -c /dev/dri/card0 &&
   test -r "$pci/vendor" && test -r "$pci/device"; then
    vendor= device=
    read -r vendor <"$pci/vendor" || :
    read -r device <"$pci/device" || :
    case "$vendor:$device" in
        0x15ad:0x0405) backend=svga ;;
        0x1af4:0x1050)
            backend=virtio
            pageflip='s/Option "PageFlip" "false"/Option "PageFlip" "true"/'
            ;;
    esac
fi
if test -n "$backend"; then
    config="/run/X11/xorg-$backend.conf"
    mkdir -p /run/X11
    temporary=$(mktemp "/run/X11/xorg-$backend.XXXXXX")
    if sed -e 's/Option "SWcursor" "true"/Option "SWcursor" "false"/' \
           -e "$pageflip" /etc/X11/xorg.conf >"$temporary"; then
        mv -f "$temporary" "$config"
        set -- -config "$config" "$@"
    else
        rm -f "$temporary"
        exit 1
    fi
fi
exec /usr/bin/Xorg "$@"
