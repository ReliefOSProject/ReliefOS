#!/bin/sh
# XDM invokes this script as the authenticated user.
#
# The lifecycle events below are written to the write-only descriptor the root
# launcher exported as RELIEFOS_XORG_EVENT_FD, never to a path the session can
# read or truncate.  Each event is recorded only after the corresponding child
# really started, so the recorded order matches the real session lifetime.
set -u
umask 077

if test -z "${HOME:-}" || test -z "${DISPLAY:-}"; then
    exit 1
fi

uid=$(id -u 2>/dev/null || printf '%s' unknown)

event_fd=${RELIEFOS_XORG_EVENT_FD:-}
event() {
    printf '%s\n' "$1"
    case "$event_fd" in
        ''|*[!0-9]*) ;;
        *) printf '%s\n' "$1" >&"$event_fd" 2>/dev/null || : ;;
    esac
}

# XDM has already authenticated the account and set its uid/home.  Root is a
# valid local desktop account in ReliefOS, so keep the authenticated uid here
# instead of rejecting it and making the greeter loop forever.
case "$uid" in
    ''|unknown)
        event 'xdm-session: authenticated uid unavailable'
        exit 1
        ;;
esac

session_log=$HOME/.xsession-errors
: > "$session_log" 2>/dev/null || session_log=${XDG_CACHE_HOME:-/tmp}/reliefos-xsession-errors."$uid"
exec >> "$session_log" 2>&1

# Start a program in the background and leave its pid in child_pid only when it
# is really running.  A missing or non-executable program is refused up front;
# a program that dies immediately is reported instead of being called "started".
child_pid=
start_child() {
    start_name=$1
    shift
    child_pid=
    if ! test -x "$1"; then
        event "$start_name failed to start"
        return 1
    fi
    "$@" &
    child_pid=$!
    # Confirm the child survived its own exec before calling it started.  Each
    # throwaway wait is a reap pass: without one a child that already exited
    # still answers kill -0 as an unreaped zombie.  Two reap probes around a
    # short settle span the window in which an exec failure or an immediate exit
    # appears, so the session does not spin on a fixed pile of throwaway forks
    # (each a full process spawn here) just to notice a child that died at exec.
    start_probes=0
    while test "$start_probes" -lt 2; do
        ( : ) & wait $! 2>/dev/null
        if ! kill -0 "$child_pid" 2>/dev/null; then
            wait "$child_pid" 2>/dev/null
            child_pid=
            event "$start_name failed to start"
            return 1
        fi
        start_probes=$((start_probes + 1))
        # Fractional settle is a widely supported extension; skip it silently
        # where only whole-second sleep exists rather than delay the session.
        if test "$start_probes" -lt 2; then
            sleep 0.05 2>/dev/null || :
        fi
    done
    return 0
}

event 'PAM authentication accepted'

icewm_pid=
st_pid=
cleanup() {
    for pid in $st_pid $icewm_pid; do
        kill "$pid" 2>/dev/null || :
    done
    for pid in $st_pid $icewm_pid; do
        wait "$pid" 2>/dev/null || :
    done
}
trap cleanup EXIT HUP INT TERM

# Create the freedesktop.org XDG user directories before any session client
# starts.  This is the same hook Xsession/xinitrc startup runs on other
# distributions; GTK file libraries expect e.g. $HOME/Templates to exist.
if test -x /usr/bin/xdg-user-dirs-update; then
    /usr/bin/xdg-user-dirs-update || :
fi

# New homes receive /etc/skel; existing accounts need the same Dillo defaults.
# The helper only creates missing standard user files and keeps personal edits.
if test -x /usr/lib/reliefos/dillo-config-init; then
    /usr/lib/reliefos/dillo-config-init || event 'Dillo defaults could not be initialized'
fi

# IceWM's native session supervisor starts icewmbg, which reads background
# preferences from the selected theme and follows subsequent theme changes.
start_child icewm /usr/bin/icewm-session || exit 1
icewm_pid=$child_pid
event "icewm started for uid=$uid"

# st fixes its palette at build time, so restore the session colours through the
# OSC colour escapes it understands, then hand it a login shell.
start_child st /usr/bin/st -T ReliefOS -g 100x32+0+0 -e /bin/sh -c 'printf "\033]10;#22242e\007\033]11;#f7f8fb\007\033]12;#3b62a6\007\033[2J\033[H"; exec "${SHELL:-/bin/sh}" -l' || exit 1
st_pid=$child_pid
event 'st started'

# The window manager owns the session lifetime; st is torn down with it.
wait "$icewm_pid"
status=$?
icewm_pid=
if test -n "$st_pid"; then
    kill "$st_pid" 2>/dev/null || :
fi
wait "$st_pid" 2>/dev/null || :
st_pid=
event 'xdm session ended'
exit "$status"
