# ReliefOS root menu.
prog "Terminal" xterm sh /etc/reliefos/icewm/terminal.sh
prog "File Manager" folder fileman
prog "Calculator" app calc
prog "System information" help osver
prog "Text editor" file nedit
prog "Web browser" app dillo
prog "xeyes" app xeyes
separator
prog "About" about xterm -title About -geometry 62x12 -e sh /etc/reliefos/icewm/about.sh
separator
prog "Log out" logout killall icewm
