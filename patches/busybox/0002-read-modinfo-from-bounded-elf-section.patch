+/* Locate NUL-delimited metadata using ELF section bounds, not adjacent file
+ * bytes. Both native-endian ELF classes are supported; memcpy avoids assuming
+ * file alignment. Invalid/truncated sections never reach the string walker. */
+static char *modinfo_area(char *image, size_t *length)
+{
+	uint64_t table, names_offset, names_size, offset, bytes;
+	uint32_t names_index, count, size, index, name, type;
+	unsigned char *ident = (unsigned char *)image;
+	if (*length < EI_NIDENT || memcmp(image, ELFMAG, SELFMAG)
+	 || ident[EI_DATA] != (BB_BIG_ENDIAN ? ELFDATA2MSB : ELFDATA2LSB))
+		return NULL;
+	if (ident[EI_CLASS] == ELFCLASS64) {
+		Elf64_Ehdr h;
+		if (*length < sizeof(h)) return NULL;
+		memcpy(&h, image, sizeof(h));
+		table = h.e_shoff; count = h.e_shnum; size = h.e_shentsize; names_index = h.e_shstrndx;
+		if (h.e_type != ET_REL || size != sizeof(Elf64_Shdr)) return NULL;
+	} else if (ident[EI_CLASS] == ELFCLASS32) {
+		Elf32_Ehdr h;
+		if (*length < sizeof(h)) return NULL;
+		memcpy(&h, image, sizeof(h));
+		table = h.e_shoff; count = h.e_shnum; size = h.e_shentsize; names_index = h.e_shstrndx;
+		if (h.e_type != ET_REL || size != sizeof(Elf32_Shdr)) return NULL;
+	} else return NULL;
+	if (!count || names_index >= count || table > *length || count > (*length - table) / size)
+		return NULL;
+	names_offset = names_size = 0;
+	/* First obtain the bounded section-name table, then find the exact area. */
+	for (index = 0; index <= count; index++) {
+		uint32_t slot = index ? index - 1 : names_index;
+		if (ident[EI_CLASS] == ELFCLASS64) {
+			Elf64_Shdr h;
+			memcpy(&h, image + table + (uint64_t)slot * size, sizeof(h));
+			name = h.sh_name; type = h.sh_type; offset = h.sh_offset; bytes = h.sh_size;
+		} else {
+			Elf32_Shdr h;
+			memcpy(&h, image + table + (uint64_t)slot * size, sizeof(h));
+			name = h.sh_name; type = h.sh_type; offset = h.sh_offset; bytes = h.sh_size;
+		}
+		if (!index) {
+			if (type != SHT_STRTAB || offset > *length || bytes > *length - offset) return NULL;
+			names_offset = offset; names_size = bytes;
+			continue;
+		}
+		if (name <= names_size && names_size - name >= sizeof(".modinfo")
+		 && memcmp(image + names_offset + name, ".modinfo", sizeof(".modinfo")) == 0) {
+			if (type != SHT_PROGBITS || offset > *length || bytes > *length - offset) return NULL;
+			*length = bytes;
+			return image + offset;
+		}
+	}
+	return NULL;
+}
