--- a/archival/tar.c
+++ b/archival/tar.c
@@ -1093,6 +1093,11 @@
 	if (opt & OPT_NOPRESERVE_OWNER)
 		tar_handle->ah_flags |= ARCHIVE_DONT_RESTORE_OWNER;
 
+	/* -p/--preserve-permissions must restore modes even for non-root,
+	 * matching GNU tar; without it the non-root umask applies. */
+	if (opt & OPT_P)
+		tar_handle->ah_flags &= ~ARCHIVE_DONT_RESTORE_PERM;
+
 	if (opt & OPT_NOPRESERVE_PERM)
 		tar_handle->ah_flags |= ARCHIVE_DONT_RESTORE_PERM;
 
