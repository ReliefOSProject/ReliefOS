      Enable su (su). Dependencies may enable it
      automatically. Libraries may also be built when another product
      needs them; image membership is controlled separately below.

config RELIEFOS_COMPONENT_APP_SU_IMAGE
    bool "Include in system images"
    default y
    depends on RELIEFOS_COMPONENT_APP_SU_BUILD

config RELIEFOS_COMPONENT_APP_SU_ENTRY
    bool "Enable the legacy application-registry entry"
    default n
    depends on RELIEFOS_COMPONENT_APP_SU_IMAGE

menuconfig RELIEFOS_COMPONENT_APP_SUDO_BUILD
    bool "sudo"
    default y
    help
      Enable sudo (sudo). Dependencies may enable it
      automatically. Libraries may also be built when another product
      needs them; image membership is controlled separately below.

config RELIEFOS_COMPONENT_APP_SUDO_IMAGE
    bool "Include in system images"
    default y
    depends on RELIEFOS_COMPONENT_APP_SUDO_BUILD

config RELIEFOS_COMPONENT_APP_SUDO_ENTRY
    bool "Enable the legacy application-registry entry"
    default n
    depends on RELIEFOS_COMPONENT_APP_SUDO_IMAGE

endmenu

menu "Third-party libraries"

menuconfig RELIEFOS_COMPONENT_LIB_SQLITE_BUILD
    bool "SQLite database library"
    default y
    help
      Enable SQLite database library (sqlite). Dependencies may enable it
      automatically. Libraries may also be built when another product
      needs them; image membership is controlled separately below.

config RELIEFOS_COMPONENT_LIB_SQLITE_IMAGE
    bool "Include in system images"
    default y
    depends on RELIEFOS_COMPONENT_LIB_SQLITE_BUILD

endmenu

